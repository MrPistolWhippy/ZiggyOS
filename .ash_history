import socket, threading, sys, json, os, hashlib, time
PORT = int(sys.argv)
PEERS = [int(p) for p in sys.argv.split(',') if p] if len(sys.argv) > 2 else []
CHUNK_SIZE = 4096
def log(tag, text, color="31"):
    print(f"\033[1;{color}m[{tag}]\033[0m {text}")
def calculate_sha256(filepath):
    hasher = hashlib.sha256()
    with open(filepath, 'rb') as f:
        while chunk := f.read(CHUNK_SIZE):
            hasher.update(chunk)
    return hasher.hexdigest()
def listen():
    s = socket.socket()
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('127.0.0.1', PORT))
    s.listen(5)
    log("ONLINE", f"Asset pipeline active on port {PORT}", "32")
    while True:
        try:
            conn, _ = s.accept()
            threading.Thread(target=handle_incoming, args=(conn,), daemon=True).start()
        except: break
def handle_incoming(conn):
    try:
        # Read dynamic variable length header safely up to newline marker
        length_bytes = b''
        while not length_bytes.endswith(b'\n'):
            char = conn.recv(1)
            if not char: return
            length_bytes += char
            
        header_length = int(length_bytes.strip())
        meta_bytes = conn.recv(header_length)
        meta = json.loads(meta_bytes.decode())
        
        filename = f"recv_{PORT}_{meta['file']}"
        size = meta['size']
        expected_hash = meta['sha256']
        log("PIPELINE-IN", f"Streaming '{meta['file']}' ({size} bytes) from Node {meta['from']}")
        
        bytes_received = 0
        with open(filename, 'wb') as f:
            while bytes_received < size:
                chunk = conn.recv(min(CHUNK_SIZE, size - bytes_received))
                if not chunk: break
                f.write(chunk)
                bytes_received += len(chunk)
        
        computed_hash = calculate_sha256(filename)
        if computed_hash == expected_hash:
            log("VERIFIED", f"SHA-256 Match: {computed_hash[:16]}... [INTEGRITY OK]", "32")
            log("SUCCESS", f"Asset '{filename}' fully reconstructed.", "32")
        else:
            log("CORRUPTED", f"Hash mismatch! Expected: {expected_hash[:16]}, Got: {computed_hash[:16]}", "31")
            if os.path.exists(filename): os.remove(filename)
            
    except Exception as e:
        log("STREAM-ERROR", str(e))
    finally: conn.close()
def push_asset(target_port, filepath):
    if not os.path.exists(filepath):
        log("ERROR", f"File '{filepath}' not found locally.")
        return
    try:
        log("HASHING", f"Calculating SHA-256 for '{filepath}'...")
        file_hash = calculate_sha256(filepath)
        size = os.path.getsize(filepath)
        filename = os.path.basename(filepath)
        
        meta_bytes = json.dumps({"from": PORT, "file": filename, "size": size, "sha256": file_hash}).encode()
        header_prefix = f"{len(meta_bytes)}\n".encode()
        
        c = socket.socket()
        c.connect(('127.0.0.1', target_port))
        
        # Dispatch length header prefix followed immediately by metadata payload
        c.sendall(header_prefix + meta_bytes)
        
        log("PIPELINE-OUT", f"Pushing '{filename}' to node {target_port}...")
        with open(filepath, 'rb') as f:
            while chunk := f.read(CHUNK_SIZE):
                c.sendall(chunk)
        log("SUCCESS", f"Asset '{filename}' pushed successfully.", "32")
        c.close()
    except Exception as e:
        log("LINK-FAILED", f"Could not stream to port {target_port}: {e}")
threading.Thread(target=listen, daemon=True).start()
time.sleep(0.2)
locals_env = {"push": push_asset, "PORT": PORT, "PEERS": PEERS}
import code
code.interact(banner="\033[1;33m[ZIGGYOS V2 LIVE - VARIABLE FRAME METADATA]\033[0m", local=locals_env)
EOF
