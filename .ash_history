# ---------------------------------------------------------------------
# LAYER-3 ADVANCED CORE: DYNAMIC MESH LEDGER WITH TOTAL DATA ABUNDANCE
# ---------------------------------------------------------------------
set -euo pipefail # Strict mode: Fail fast on errors, unbound variables, or broken pipes
# Visual styling anchors
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'
# Local Node Parameters
NODE_NAME="node_p20"
LEDGER_FILE="mesh_topology_ledger.db"
PRUNE_TIMEOUT_MS=200 # Max time to wait for a peer before purging it
# Helper function to generate standardized 64-character SHA-256 strings
sha256_hash() {
    echo -n "$1" | sha256sum | awk '{print $1}'
}
# Convert hex character directly to an integer value for mathematical analysis
hex_to_dec() {
    echo "$((16#$1))"
}
# 1. CORE UPGRADE: Mathematical XOR Distance Metric Filter
# Calculates bitwise distance between two hex keys character by character
calculate_xor_distance() {
    local key1="$1"
    local key2="$2"
    local distance_score=0
    
    # Analyze the first 8 characters of the hashes to generate a fast proximity metric
    for i in {0..7}; do
        local char1="${key1:$i:1}"
        local char2="${key2:$i:1}"
        local dec1; dec1=$(hex_to_dec "$char1")
        local dec2; dec2=$(hex_to_dec "$char2")
        
        # Perform bitwise exclusive OR operation
        local xor_result=$(( dec1 ^ dec2 ))
        # Accumulate structural distance (higher value = logically further apart)
        distance_score=$(( distance_score + xor_result ))
    done
    echo "$distance_score"
}
LOCAL_NODE_ID=$(sha256_hash "$NODE_NAME")
echo -e "${GREEN}[*] STACK INITIALISED // NODE ID: ${LOCAL_NODE_ID}${NC}"
echo "---------------------------------------------------------------------"
# Define raw, unverified peer targets currently trying to sync with node p20
declare -A network_peers
