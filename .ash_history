cat << 'EOF' > /mnt/api_server.py
import sys, os, json, logging
from http.server import BaseHTTPRequestHandler, HTTPServer
logging.basicConfig(filename='/mnt/server_errors.log', level=logging.ERROR)
class ZiggyOSHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args): pass
    def do_GET(self):
        # Serve the HTML front-end file directly to the browser
        try:
            self.send_response(200)
            self.send_header('Content-Type', 'text/html')
            self.end_headers()
            with open('/mnt/dashboard_panel.html', 'rb') as f:
                self.wfile.write(f.read())
        except Exception as e:
            self.send_error(404, f"File Not Found: {e}")
    def do_POST(self):
        try:
            content_length = int(self.headers['Content-Length'])
            post_data = self.rfile.read(content_length).decode('utf-8')
            try:
                data = json.loads(post_data)
                action = data.get("action", "")
            except:
                action = post_data
            if action == "node_intercept":
                res = {"status": "SUCCESS", "log": "[MESH EVENT] Interfaced with node."}
            elif action == "clear_cache":
                res = {"status": "SUCCESS", "log": "[KERNEL] Cache Purged."}
            elif action == "sys_reboot":
                self.send_response(200)
                self.end_headers()
                self.wfile.write(b'{"status":"REBOOTING"}')
                os.system("pkill -f python3"); sys.exit(0)
            else:
                raise ValueError(f"Unknown: {action}")
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps(res).encode())
        except Exception as e:
            logging.error(f"Crash: {e}")
            self.send_response(500)
            self.end_headers()
EOF
