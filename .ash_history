<div style="display:flex;gap:10px;margin-top:10px;width:500px">
<div id="l" style="background:#000;padding:5px;height:100px;width:60%;overflow-y:auto;color:#4ade80;font-size:0.8rem;border:1px solid #4ade80;box-shadow:0 0 9px #4ade80"></div>
<div style="background:#111827;padding:5px;height:100px;width:40%;color:#38bdf8;font-size:0.8rem;border:1px solid #38bdf8;box-shadow:0 0 9px #38bdf8">
<b>SYS DIAG</b><div id="i">TAP NODE</div>SYNC:<span id="sy" style="color:#4ade80">100%</span>
</div>
<input type="text" id="t" placeholder="CMD..." style="background:#000;color:#fff;border:1px solid #4ade80;box-shadow:0 0 9px #4ade80;width:488px;padding:8px;outline:none">
<script>
let bl=document.getElementById('b'),ve=document.getElementById('v'),sh=document.getElementById('s'),l=document.getElementById('l'),t=document.getElementById('t'),sy=document.getElementById('sy'),insp=document.getElementById('i'),cv=document.getElementById('c'),c=cv.getContext('2d'),bdy=document.getElementById('o');
let fl=false,p=0,sel="None",n=[{n:"Loopin",x:250,y:100,c:"#38bdf8"},{n:"US-E",x:400,y:50,c:"#22c55e"},{n:"US-W",x:100,y:60,c:"#ec4899"},{n:"US-S",x:250,y:170,c:"#eab308"}];
setInterval(()=>{
bl.innerText=parseInt(bl.innerText)+Math.floor(Math.random()*3);
if(!fl&&Math.random()<0.08){l.innerHTML+=`<div>[${new Date().toLocaleTimeString()}] VAR US-W</div>`;l.scrollTop=l.scrollHeight;}
sy.innerText=fl?Math.floor(Math.random()*30+40)+"%":"100%";sy.style.color=fl?"#f87171":"#4ade80";
},1000);
setInterval(()=>{
c.clearRect(0,0,500,200);c.strokeStyle='#1e293b';c.lineWidth=0.5;
for(let i=0;i<500;i+=20){c.beginPath();c.moveTo(i,0);c.lineTo(i,200);c.stroke();c.beginPath();c.moveTo(0,i/2.5);c.lineTo(500,i/2.5);c.stroke();}
n.forEach(i=>{c.strokeStyle=i.c;c.lineWidth=(i.n===sel)?4:2;c.beginPath();c.moveTo(250,100);c.lineTo(i.x,i.y);c.stroke();});
p=(p+0.04)%1;n.forEach(i=>{if(i.n!=="Loopin"){c.fillStyle='#fff';c.beginPath();c.arc(250+(i.x-250)*p,100+(i.y-100)*p,5,0,7);c.fill();}});
n.forEach(i=>{c.fillStyle=i.c;c.beginPath();c.arc(i.x,i.y,(i.n===sel)?12:8,0,7);c.fill();c.fillStyle='#fff';c.fillText(i.n,i.x+15,i.y+4);});
},30);
cv.addEventListener('click',(e)=>{
let r=cv.getBoundingClientRect(),x=(e.clientX-r.left)*(500/r.width),y=(e.clientY-r.top)*(200/r.height);
n.forEach(i=>{if(Math.sqrt((x-i.x)**2+(y-i.y)**2)<15){sel=i.n;insp.innerHTML=`ID: ${i.n}<br>STAT: ONLINE<br>X:${i.x} Y:${i.y}`;}});
});
t.addEventListener('keydown',(e)=>{
if(e.key==='Enter'&&t.value.trim()!==""){
let v=t.value.trim().toLowerCase();
if(v==='/clear'){l.innerHTML=`<div>[Console purged]</div>`;fl=false;sel="None";insp.innerText="TAP NODE";ve.innerText="3";sh.innerText="53";}
else if(v==='/overload'){l.innerHTML+=`<div style="color:#f87171">[CRIT] Overload...</div>`;fl=true;ve.innerText="103";sh.innerText="153";}
else if(v==='/macspoof'){
let m=`D4:9A:20:${Math.floor(Math.random()*89+10)}:${Math.floor(Math.random()*89+10)}`;
l.innerHTML+=`<div style="color:#38bdf8">[SYS] MAC Spoofed: ${m}</div>`;
fetch('http://127.0.0',{method:'POST',body:JSON.stringify({msg:v})}).catch(()=>{});
}else{l.innerHTML+=`<div>[CMD]: ${v}</div>`;}
l.scrollTop=l.scrollHeight;t.value="";
}
});
</script></body></html>
