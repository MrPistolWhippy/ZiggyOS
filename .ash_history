        echo -e "  - Total Distributed Mesh Peers : ${GOLD}${TOTAL_P} Active Mesh Shards${RESET}"
    else
        echo -e "  - SQL Storage Database Link    : ${CRIMSON}DISCONNECTED${RESET}"
    fi
    
    echo -e "${CRIMSON}======================================================================${RESET}"
    echo -e "Scanning core network matrix layers... Next sample refresh cycle in 3s."
    sleep 3
done
EOF
