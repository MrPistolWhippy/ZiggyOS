import socket, threading, json, os, time, hashlib
P = list(range(7001, 7004))
CHUNK = 4096
def listen(port):
    s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('127.0.0.1', port)); s.listen(5)
    print(f"\033[1;32m[NODE-{port}-ONLINE]\033[0m Gateway listening smoothly...")
    while True:
        try:
            c, _ = s.accept(); rl = b''
            while not rl.endswith(b'\n'): rl += c.recv(1)
            meta = json.loads(c.recv(int(rl.strip())).decode())
            fn, t0, rb = f"n_{port}_{meta['file']}", time.time(), 0
            
            print(f"\n\033[1;33m[NODE-{port}-UNPACK]\033[0m Receiving: {meta['file']} targeting Node {meta['target']}")
            with open(fn, 'wb') as o:
                while rb < meta['size']:
                    k = c.recv(min(CHUNK, meta['size'] - rb)); o.write(k); rb += len(k)
            
            dt = time.time() - t0
            speed = (rb / 1024 / 1024) / dt if dt > 0 else 0
            
            h = hashlib.sha256()
            with open(fn, 'rb') as f:
                while chunk := f.read(CHUNK): h.update(chunk)
                
            status = 'VERIFIED' if h.hexdigest() == meta['hash'] else 'FAIL'
            print(f"\033[1;32m[NODE-{port}-METRIC]\033[0m Speed: {speed:.1f} MB/s | Cryptography: {status}")
            
            if meta['target'] != port:
                nxt = 7002 if port == 7001 else 7003
                print(f"\033[1;34m[NODE-{port}-RELAY]\033[0m Forwarding down mesh to Node {nxt}")
                push(nxt, meta, fn); os.remove(fn)
            else:
                print(f"\033[1;32m[NODE-{port}-LANDED]\033[0m Asset safely saved locally -> {fn}\n>>> ", end="")
        except Exception as e: print(f"Error: {e}")
def push(hop, meta, fp):
    try:
        mb = json.dumps(meta).encode(); sk = socket.socket(); sk.connect(('127.0.0.1', hop))
        sk.sendall(f"{len(mb)}\n".encode() + mb)
        with open(fp, 'rb') as f:
            while chunk := f.read(CHUNK): sk.sendall(chunk)
        sk.close()
    except:
        print(f"\033[1;31m[LINK-FAILED]\033[0m Node {hop} offline. Local fallback engaged -> fallback_{meta['file']}\n>>> ", end="")
        if os.path.exists(fp): os.rename(fp, f"fallback_{meta['file']}")
def inject(t, fp):
    if not os.path.exists(fp): print("File missing"); return
    h = hashlib.sha256()
    with open(fp, 'rb') as f:
        while chunk := f.read(CHUNK): h.update(chunk)
    print(f"\n\033[1;36m[ORIGIN-7001]\033[0m Packing envelope and injecting '{fp}' to node matrix...")
    push(7001, {'from': 7001, 'target': t, 'file': os.path.basename(fp), 'size': os.path.getsize(fp), 'hash': h.hexdigest()}, fp)
for p in P: threading.Thread(target=listen, args=(p,), daemon=True).start()
time.sleep(0.3)
import code; code.interact(banner="\033[1;36m[ZIGGYOS COMPACT PIPELINE REBOOTED]\033[0m Type: push(7003, 'system.img')", local={'push': inject})
