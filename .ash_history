python3 -c "
with open('auto_mesh.py', 'w') as f:
    f.write('''import socket, threading, sys, json, os, time
PORT = int(sys.argv[1])
MCAST_GRP = '239.255.255.250'
MCAST_PORT = 1900
CHUNK = 4096
PEERS = set()
def log(tag, text, color='31'):
    print(f'\\\\n\\\\033[1;{color}m[{tag}]\\\\033[0m {text}\\\\n>>> ', end='')
def beacon_sender():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
    payload = json.dumps({'op': 'ALIVE', 'port': PORT}).encode()
    while True:
        try: s.sendto(payload, (MCAST_GRP, MCAST_PORT))
        except: pass
        time.sleep(3)
def beacon_listener():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('', MCAST_PORT))
    mreq = socket.inet_aton(MCAST_GRP) + socket.inet_aton('0.0.0.0')
    s.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, mreq)
    while True:
        try:
            data, _ = s.recvfrom(1024)
            msg = json.loads(data.decode())
            if msg['op'] == 'ALIVE' and msg['port'] != PORT:
                if msg['port'] not in PEERS:
                    PEERS.add(msg['port'])
                    log('DISCOVERY', f'Found new peer node on local network: {msg[\"port\"]}', '32')
        except: pass
def listen():
    s = socket.socket()
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('0.0.0.0', PORT))
    s.listen()
    while True:
        try:
            c, _ = s.accept()
            rl = b''
            while not rl.endswith(b'\\\\n'): rl += c.recv(1)
            meta = json.loads(c.recv(int(rl.strip())).decode())
            fn = f'recv_{PORT}_{meta[\"file\"]}' if meta['target'] == PORT else f'tmp_{PORT}_{meta[\"file\"]}'
            with open(fn, 'wb') as out:
                rb = 0
                while rb < meta['size']:
                    chunk = c.recv(min(CHUNK, meta['size'] - rb))
                    if not chunk: break
                    out.write(chunk)
                    rb += len(chunk)
            if meta['target'] != PORT:
                next_hop = meta['target'] if meta['target'] in PEERS else (list(PEERS)[0] if PEERS else None)
                if next_hop: push_forward(next_hop, meta, fn); os.remove(fn)
            else: log('SUCCESS', f'Asset fully landed locally -> {fn}', '32')
        except: pass
def push_forward(hop, meta, fp):
    try:
        mb = json.dumps(meta).encode()
        c = socket.socket(); c.connect(('127.0.0.1', hop))
        c.sendall(f'{len(mb)}\\\\n'.encode() + mb)
        with open(fp, 'rb') as src:
            while chunk := src.read(CHUNK): c.sendall(chunk)
        c.close()
    except: pass
def inject_push(target, fp):
    if not os.path.exists(fp): print('File not found'); return
    if not PEERS: print('No discovered peers available yet.'); return
    meta = {'target': target, 'file': os.path.basename(fp), 'size': os.path.getsize(fp)}
    next_hop = target if target in PEERS else list(PEERS)[0]
    log('MESH-OUT', f'Injecting data routing through discovered hop {next_hop}...', '34')
    push_forward(next_hop, meta, fp)
threading.Thread(target=beacon_sender, daemon=True).start()
threading.Thread(target=beacon_listener, daemon=True).start()
threading.Thread(target=listen, daemon=True).start()
log('SYSTEM', f'Autonomous ZiggyOS Node operational on port {PORT}', '36')
import code; code.interact(banner=\"\", local={'push': inject_push, 'peers': lambda: print(list(PEERS))})
''')
print('Script auto_mesh.py compiled successfully.')"
