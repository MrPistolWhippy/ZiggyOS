cat << 'EOF' > /mnt/run.sh
#!/bin/sh
killall -9 python3 2>/dev/null
pkill -f python3 2>/dev/null
sleep 0.5
python3 /mnt/api_server.py &
echo "=========================================="
echo "ZIGGY-OS MESH CONSOLE READY FOR OPERATION"
echo "1) Rotate Local Shard Interface MAC Address"
echo "2) Keep Default Native Settings Active"
echo "=========================================="
read -p "Select Mode (1-2): " mode
if [ "$mode" = "1" ]; then
    macchanger -r eth0 2>/dev/null || echo "[MOCK] MAC Spoofed: D4:9A:20:99:FF:AA"
else
    echo "Using default hardware parameters."
fi
EOF
chmod +x /mnt/run.sh
