import json, shutil, sys
from http.server import BaseHTTPRequestHandler, HTTPServer
DB = "north_shore_archive.json"
# Injected Historical Data (Part 4)
H = {"part_4_history": {"event": "King of Rail 2007", "winner": "Scott Brodie", "2nd": "Richard Shriane"}}
class S(BaseHTTPRequestHandler):
    def do_GET(self):
        d = json.load(open(DB))
        # Search Endpoint: /search?q=text
        if "search" in self.path:
            q = self.path.split("?q=")[-1].lower()
            d = {k: v for k, v in d.items() if q in json.dumps(v).lower()}
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(json.dumps(d, indent=2).encode())
    def do_POST(self):
        # Backup Endpoint
        if self.path == "/backup": shutil.copy2(DB, "north_shore_archive_bak.json")
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b'{"status": "success"}')
if __name__ == "__main__":
    try:
        f = json.load(open(DB)); f.update(H); json.dump(f, open(DB, "w"), indent=2)
    except: pass
    HTTPServer(("127.0.0.1", 8000), S).serve_forever()
