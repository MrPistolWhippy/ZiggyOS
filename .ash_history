def decode_eas_rfid(h):
    try:
        r = bytes.fromhex(h); eas = r[0] & 0x01; uid_str = r[1:5].hex().upper()
        status = "\033[1;32mDEACTIVATED/CLEAR\033[0m" if eas == 0 else "\033[1;31mALARM_RING_ACTIVE\033[0m"
        return f"UID:{uid_str}|EAS:{status}"
    except: return "UID:UNKNOWN|EAS:DISRUPTED"
EOF
cat << 'EOF' >> launch_ptcd_final.py
def render_ptcd_dashboard(cy):
    print(f"\n\033[1;35m=======================================================================\n⚡ ZIGGY-OS PHASE SIX ALL-SYSTEMS CORE MESH | SWEEP #{cy} ⚡\n=======================================================================\033[0m")
    co = sqlite3.connect("archive.db"); cu = co.cursor()
    cu.execute("SELECT payload, prev_hash FROM p6_ledger ORDER BY block_idx DESC LIMIT 1")
    row = cu.fetchone()
    if row: prev = hashlib.sha256(row[0] + row[1].encode()).hexdigest()
    else: prev = "0" * 64
    al, sp, fl, ts = int(time.time() % 3000 + 4000), random.randint(320, 480), round(random.uniform(60.0, 99.9), 1), time.strftime("%H:%M:%S")
    cu.execute("INSERT INTO node_gamma_telemetry (altitude_ft, speed_knots, fuel_pct, timestamp) VALUES (?, ?, ?, ?)", (al, sp, fl, ts))
    mock_hex = random.choice(["00ABCDEF12", "01FEDCBA98", "0011223344"])
    eas_tel = decode_eas_rfid(mock_hex); raw_bin = struct.pack("!IHH", al, sp, cy) + eas_tel.encode()
    curr_hash = hashlib.sha256(raw_bin + prev.encode()).hexdigest()
    cu.execute("INSERT INTO p6_ledger (block_idx, payload, prev_hash, timestamp) VALUES (?, ?, ?, ?)", (cy, sqlite3.Binary(raw_bin), prev, ts))
    co.commit()
    print(f"\033[1;34m[📡 NODE GAMMA SCHEMA (NGts+)]\033[0m -> Alt: {al} ft | Velocity: {sp} kts | Fuel Pool: {fl}%")
    print(f"\033[1;36m[🏷️ EAS RFID RING]\033[0m -> Demodulated Scan: {eas_tel}")
    print(f"\033[1;34m[⛓️ BLOCK HASH]\033[0m -> {curr_hash[:32]}...")
    co.close()
EOF
