def run_fused_deck():
    sys.stdout.write("\033[H\033[J")
    f = 0
    base_power = 9001
    
    while True:
        f += 1; sys.stdout.write("\033[H")
        h = H(str(time.time()))
        w, _ = os.get_terminal_size()
        
