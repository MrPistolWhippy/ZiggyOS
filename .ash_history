import sqlite3
import sys
def init_db():
    conn = sqlite3.connect(':memory:')
    cursor = conn.cursor()
    # Users table for standard and blind SQLi
    cursor.execute("CREATE TABLE users (id INT, username TEXT, password TEXT)")
    cursor.execute("INSERT INTO users VALUES (1, 'admin', 'SecuredFlag2026!')")
    cursor.execute("INSERT INTO users VALUES (2, 'guest', 'guest123')")
    
    # Guestbook table for Stored XSS simulation
    cursor.execute("CREATE TABLE guestbook (id INTEGER PRIMARY KEY AUTO_INCREMENT, comment TEXT)")
    conn.commit()
    return conn
def secure_sqli(conn):
    print("\n--- SECURE SQL INJECTION MODULE ---")
    user_input = input("Enter User ID: ")
    cursor = conn.cursor()
    query = "SELECT username FROM users WHERE id = ?"
    print(f"[DEBUG] Raw Query Sent to Engine: {query}")
    cursor.execute(query, (user_input,))
    results = cursor.fetchall()
    if not results:
        print("[-] No records found.")
    for row in results:
        print(f"[+] Record Extracted: User Found -> {row[0]}")
def blind_sqli(conn):
    print("\n--- BLIND SQL INJECTION CHALLENGE ---")
    print("Goal: Infer the admin password character by character.")
    user_input = input("Enter User ID to check availability: ")
    cursor = conn.cursor()
    
    # VULNERABLE: Direct f-string interpolation allowing true/false validation leaks
    query = f"SELECT username FROM users WHERE id = {user_input}"
    print(f"[DEBUG] Raw Query Sent to Engine: {query}")
    
    try:
        cursor.execute(query)
        result = cursor.fetchone()
        if result:
            print("[+] Status: ID is registered in database.")
        else:
            print("[-] Status: ID is vacant / not found.")
    except Exception:
        print("[-] Status: Database Error Encountered.")
def stored_xss(conn):
    print("\n--- STORED XSS ENVIRONMENT ---")
    print("1. Read Guestbook Comments")
    print("2. Submit New Comment")
    choice = input("Select Action (1-2): ")
    cursor = conn.cursor()
    
    if choice == "1":
        cursor.execute("SELECT comment FROM guestbook")
        comments = cursor.fetchall()
        print("\n--- RENDERED BROWSER PAGE LAYOUT ---")
        if not comments:
            print("(No comments submitted yet)")
