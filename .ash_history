import sys, time, os, glob, re
cfg = {"l": 2048, "w": {"risk": 5, "error": 4, "fault": 4, "valid": -3, "secure": -5}}
def process_query(vi):
    t = vi.strip().lower().split()
    if not t: return "[VOID]"
    cmd = t[0]
    if cmd == "/set" and len(t) > 2:
        try:
            v = int(t[2])
            if t[1] == "ceil": cfg["l"] = v; return f"[SET] Ceil: {v}B"
            cfg["w"][t[1]] = v; return f"[SET] '{t[1]}' = {v}"
        except: return "[ERR]"
    if cmd == "/sort":
        try:
            e = []
            with open("/mnt/truth_logs.txt") as f:
                for l in f:
                    m = re.search(r"SCORE:\s*(-?\d+)", l)
                    if m: e.append((int(m.group(1)), l.strip()))
            e.sort(key=lambda x: x[0], reverse=True)
            return "\n".join(x[1] for x in e)
        except: return "[EMPTY]"
    if cmd == "/read" and len(t) > 1:
        f = t[1]
        p = f if f.startswith("/mnt/") else f"/mnt/{f}"
        if not os.path.exists(p): return f"[ERR] Not found: {p}"
        with open(p) as fn: return "\n".join(l.strip() for l in fn)
    if cmd == "/list":
        fl = glob.glob("/mnt/truth_logs_bak_*.txt")
        return "\n".join(f"{os.path.basename(x)} | {os.path.getsize(x)}B" for x in fl) if fl else "[EMPTY]"
    if "/purge" in t:
        if not os.path.exists("/mnt/truth_logs.txt"): return "[CLEAN]"
        p = f"/mnt/truth_logs_bak_{int(time.time())}.txt"
        os.rename("/mnt/truth_logs.txt", p); return f"[ARCHIVED] {p}"
    sc = sum(cfg["w"].get(x, 0) for x in t)
    an = f"SCORE: {sc} " + ("(CRIT)" if sc > 3 else "(SAFE)")
    res = f"[EVAL] {' '.join(t[1:])} | {an}" if "/verify" in t else f"[READY] 0 threats" if "/status" in t else f"[LOG] {' '.join(t)} | {an}"
    try:
        with open("/mnt/truth_logs.txt", "a") as f: f.write(f"{time.strftime('%X')} {res}\n")
        if os.path.getsize("/mnt/truth_logs.txt") > cfg["l"]: print("⚠️ [ALERT] Size exceeded.")
    except: pass
    return res
print("=== SUITE ONLINE ===")
try:
    while True: print(process_query(input("\nTRUTH_PROMPT > ")))
except: print("\n[HALT]")
