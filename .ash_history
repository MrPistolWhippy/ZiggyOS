python3 -c "
import socket, threading, json, os, time, sys
MCAST_GRP = '239.255.255.250'
MCAST_PORT = 1900
CHUNK = 4096
# Tracking topology state matrices locally
network_topology = {7001: set(), 7002: set(), 7003: set()}
def log(node, tag, text, color='31'):
    print(f'\n\033[1;{color}m[NODE-{node}][{tag}]\033[0m {text}\n>>> ', end='')
def beacon_sender(port):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
    payload = json.dumps({'op': 'ALIVE', 'port': port}).encode()
    while True:
        try: s.sendto(payload, (MCAST_GRP, MCAST_PORT))
        except: pass
        time.sleep(2)
def beacon_listener():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('', MCAST_PORT))
    mreq = socket.inet_aton(MCAST_GRP) + socket.inet_aton('0.0.0.0')
    s.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, mreq)
    while True:
        try:
            data, _ = s.recvfrom(1024)
            msg = json.loads(data.decode())
            if msg['op'] == 'ALIVE':
                p = msg['port']
                # Cross-pollinate dynamic peer paths for all active running components
                for node in network_topology:
                    if p != node and p not in network_topology[node]:
                        network_topology[node].add(p)
                        log(node, 'DISCOVERY', f'Dynamically mapped peer node -> {p}', '32')
        except: pass
def listen(port):
    s = socket.socket()
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('127.0.0.1', port))
    s.listen(5)
    while True:
        try:
            c, _ = s.accept()
            rl = b''
            while not rl.endswith(b'\n'): rl += c.recv(1)
            meta = json.loads(c.recv(int(rl.strip())).decode())
            
            fn = f'recv_{port}_{meta[\"file\"]}' if meta['target'] == port else f'tmp_{port}_{meta[\"file\"]}'
            log(port, 'INBOUND', f'Handling routing frame for destination: {meta[\"target\"]}', '33')
            
            with open(fn, 'wb') as out:
                rb = 0
                while rb < meta['size']:
                    chunk = c.recv(min(CHUNK, meta['size'] - rb))
                    if not chunk: break
                    out.write(chunk)
                    rb += len(chunk)
            
            if meta['target'] != port:
                # Store and forward path router calculation
                next_hop = 7002 if port == 7001 else 7003
                log(port, 'ROUTER', f'Forwarding package down mesh line to node {next_hop}', '35')
                push_forward(next_hop, meta, fn)
                if os.path.exists(fn): os.remove(fn)
            else:
                log(port, 'SUCCESS', f'Asset fully arrived at targeted storage layer -> {fn}', '32')
        except: pass
def push_forward(hop, meta, fp):
    try:
        mb = json.dumps(meta).encode()
        c = socket.socket(); c.connect(('127.0.0.1', hop))
        c.sendall(f'{len(mb)}\n'.encode() + mb)
        with open(fp, 'rb') as src:
            while chunk := src.read(CHUNK): c.sendall(chunk)
        c.close()
    except: pass
def inject_push(target, fp):
    if not os.path.exists(fp): print('File not found'); return
    meta = {'target': target, 'file': os.path.basename(fp), 'size': os.path.getsize(fp)}
    log(7001, 'ORIGIN', f'Injecting data sequence aimed for Node {target}...', '34')
    push_forward(7002, meta, fp)
# Instantiate network landscape components onto parallel tracking threads
threading.Thread(target=beacon_listener, daemon=True).start()
for port in:
    threading.Thread(target=beacon_sender, args=(port,), daemon=True).start()
    threading.Thread(target=listen, args=(port,), daemon=True).start()
time.sleep(1)
print('\n\033[1;36m[ZIGGYOS AUTONOMOUS OMNI-MESH ONLINE]\033[0m')
print('Simulating nodes 7001, 7002, and 7003 running simultaneously.')
print('Execute: push(7003, \"system.img\")\n')
