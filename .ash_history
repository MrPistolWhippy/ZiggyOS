<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"></head>
<body id="bdy" style="background:#0d0f12;color:#cbd5e1;font-family:monospace;padding:20px;user-select:none">
<h2 style="color:#ef4444;margin:0;font-size:1.8rem">[CRITICAL OVERRIDE ACTIVE // ENG: MAX]</h2>
<div style="display:flex;gap:30px;font-size:2.2rem;margin:25px 0;font-weight:bold">
<div>📦 <span id="b">1,540</span> Blocks</div><div style="color:#f87171">⚠️ <span id="v">3</span> Vectors</div><div>🌐 <span id="s">53</span> Shards</div>
</div>
<h3 style="font-size:1.2rem;color:#94a3b8;margin-bottom:5px">Topology Grid & Systems Stream</h3>
<canvas id="c" width="500" height="200" style="background:#0a0c10;border:2px solid #ef4444;border-radius:4px"></canvas>
<div id="l" style="background:#000;padding:12px;height:120px;overflow-y:auto;color:#4ade80;margin-top:12px;border-radius:4px;font-size:1rem;border:1px solid #334155"></div>
<input type="text" id="t" placeholder="EXECUTE ROOT CORE CMD (/overload, /kill, /clear)..." style="background:#000;color:#fff;border:2px solid #4ade80;width:472px;padding:12px;font-family:monospace;font-size:1rem;margin-top:8px;outline:none;border-radius:4px">
<script>
let bl=document.getElementById('b'),ve=document.getElementById('v'),sh=document.getElementById('s'),l=document.getElementById('l'),t=document.getElementById('t'),cv=document.getElementById('c'),c=cv.getContext('2d'),bdy=document.getElementById('bdy');
let fl=false,pct=0,n=[{n:"Loopin",x:250,y:100,c:"#38bdf8"},{n:"US-E",x:400,y:50,c:"#4ade80"},{n:"US-W",x:100,y:60,c:"#f87171"},{n:"US-S",x:250,y:170,c:"#4ade80"}];
setInterval(() => {
    bl.innerText=(parseInt(bl.innerText.replace(/,/g,''))+Math.floor(Math.random()*3)).toLocaleString();
    if(!fl && Math.random()<0.08){l.innerHTML+=`<div>[${new Date().toLocaleTimeString()}] [WARN] Variance on US-WEST</div>`;l.scrollTop=l.scrollHeight;}
},1000);
setInterval(() => { if(fl){bdy.style.background=bdy.style.background==="rgb(239, 68, 68)"?"#0d0f12":"#ef4444";} },400);
function draw(){
    c.clearRect(0,0,500,200);c.strokeStyle='#1e293b';c.lineWidth=0.5;
    for(let i=0;i<500;i+=20){c.beginPath();c.moveTo(i,0);c.lineTo(i,200);c.stroke();}
    for(let j=0;j<200;j+=20){c.beginPath();c.moveTo(0,j);c.lineTo(500,j);c.stroke();}
    n.forEach(i=>{c.strokeStyle='#334155';c.lineWidth=1.5;c.beginPath();c.moveTo(250,100);c.lineTo(i.x,i.y);c.stroke();});
    
    // Animate Data Trace Particles traveling across paths
    pct=(pct+0.01)%1;
    n.forEach(i=>{
        if(i.n!=="Loopin"){
            let px=250+(i.x-250)*pct, py=100+(i.y-100)*pct;
            c.fillStyle='#38bdf8';c.beginPath();c.arc(px,py,4,0,7);c.fill();
        }
    });
    n.forEach(i=>{c.fillStyle=i.c;c.beginPath();c.arc(i.x,i.y,6,0,7);c.fill();c.fillStyle='#fff';c.font='11px monospace';c.fillText(i.n,i.x+12,i.y+4);});
}
setInterval(draw,30);
t.addEventListener('keydown',(e)=>{
    if(e.key==='Enter' && t.value.trim()!==""){
        let v=t.value.trim().toLowerCase();
        if(v==='/clear'){l.innerHTML=`<div>[Console log array purged clean]</div>`;fl=false;bdy.style.background="#0d0f12";ve.innerText="3";sh.innerText="53";}
        else if(v==='/overload'){l.innerHTML+=`<div style="color:#f87171;font-weight:bold">[CRIT] Injection threat: Spawning ghost shards...</div>`;fl=true;ve.innerText="103";sh.innerText="153";}
        else if(v==='/kill'){
            let cd=10; t.disabled=true;
            // Initiate un-bypassable countdown loop sequence sequence
            let timer=setInterval(()=>{
                l.innerHTML+=`<div style="color:#ef4444;font-weight:bold">[HALT] KERNEL REBOOT TERMINATION IN ${cd}s...</div>`;
                l.scrollTop=l.scrollHeight; cd--;
                if(cd<0){
                    clearInterval(timer);
                    fetch('http://127.0.0',{method:'POST'}).catch(()=>{});
                    l.innerHTML=`<div style="color:#f87171">[DEAD] Pipeline Disconnected.</div>`;
                }
            },1000);
        }else{l.innerHTML+=`<div>[CMD] Local runtime: ${v}</div>`;}
