import sqlite3, struct
DB = "archive.db"
print("\n\033[1;32m=== ZIGGY-OS QUANTUM LEDGER BINARY UNPACKER ===\033[0m")
try:
    conn = sqlite3.connect(DB)
    cursor = conn.cursor()
    cursor.execute("SELECT block_idx, payload, prev_hash, timestamp FROM p6_ledger ORDER BY block_idx ASC")
    rows = cursor.fetchall()
    
    for row in rows:
        idx, b_payload, p_hash, ts = row
        # Strip structural binary metadata out of memory using exact offsets
        header_len = struct.calcsize("!IHH")
        header = b_payload[:header_len]
        eas_bytes = b_payload[header_len:]
        
        alt, spd, cyc = struct.unpack("!IHH", header)
        eas_data = eas_bytes.decode()
        
        print(f"\n🧱 [BLOCK #{idx}] | Verified Timestamp: {ts}")
        print(f"   ├─ Extracted Metrics -> Alt: {alt} ft | Speed: {spd} kts | Cycle ID: {cyc}")
        print(f"   ├─ Demodulated Tag   -> \033[1;36m{eas_data}\033[0m")
        print(f"   └─ Chained Ancestor  -> {p_hash[:32]}...")
    conn.close()
except Exception as e:
    print(f"[!] Extraction failure: {e}")
print("\n\033[1;32m===============================================\033[0m")
EOF
