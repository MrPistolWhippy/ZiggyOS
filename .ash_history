    if cmd == "/read":
        try:
            fl = sorted(glob.glob("/mnt/truth_logs_bak_*.txt"))
            if not fl: return "[NO BACKUPS FOUND]"
            p = fl[-1] if len(t) == 1 else (t[1] if t[1].startswith("/mnt/") else f"/mnt/{t[1]}")
            if not os.path.exists(p): return f"[NOT FOUND] {p}"
            with open(p) as fn: return f"=== FILE: {os.path.basename(p)} ===\n" + "\n".join(l.strip() for l in fn)
        except Exception as err: return f"[ERR] {err}"
    if cmd == "/list":
        fl = glob.glob("/mnt/truth_logs_bak_*.txt")
        return "\n".join(f"{os.path.basename(x)} | {os.path.getsize(x)}B" for x in fl) if fl else "[EMPTY]"
    if "/purge" in [x.lower() for x in t]:
        if not os.path.exists("/mnt/truth_logs.txt"): return "[CLEAN]"
        p = f"/mnt/truth_logs_bak_{int(time.time())}.txt"
        os.rename("/mnt/truth_logs.txt", p); return f"[ARCHIVED] {p}"
    sc = sum(c["w"].get(x.lower(), 0) for x in t)
    an = f"SCORE: {sc} " + ("(CRIT)" if sc > 3 else "(SAFE)")
    res = f"[EVAL] {' '.join(t[1:])} | {an}" if "/verify" in t[0].lower() else f"[READY] 0 threats" if "/status" in t[0].lower() else f"[LOG] {' '.join(t)} | {an}"
    try:
        with open("/mnt/truth_logs.txt", "a") as f: f.write(f"{time.strftime('%X')} {res}\n")
        if os.path.getsize("/mnt/truth_logs.txt") > c["l"]: print("⚠️ [ALERT] Size exceeded.")
    except: pass
    return res
print("=== SUITE ONLINE ===")
try:
    while True: print(q(input("\nTRUTH_PROMPT > ")))
except: print("\n[HALT]")
EOF
