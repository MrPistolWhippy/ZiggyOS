\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{stealth}[2026/06/19 Reusable Runtime Decryption Engine]
\RequirePackage{luacode}
\begin{luacode*}
local function rot13_decode(line)
    local decoded = line:gsub("[a-zA-Z]", function(c)
        local base = c:lower() == c and 97 or 65
        return string.char(((c:byte() - base + 13) % 26) + base)
    end)
    return decoded
end
local function intercept_input(env)
    local original_reader = env.reader
    env.reader = function()
        local line = original_reader()
        if line then
            -- Intercepts any lines flagged with [CRYPT]
            if line:find("%%%[CRYPT%]") then
                return rot13_decode(line:gsub("%%%[CRYPT%]", ""))
            end
            return line
        end
    end
end
luatexbase.add_to_callback("open_read_file", intercept_input, "GlobalStealthDecoder")
\end{luacode*}
\end{input}
