#!/bin/sh
# ==============================================================================
#  ZIGGYOS SEMANTIC OFFLINE TERMINAL WEB BROWSER GATEWAY CORE
# ==============================================================================
DB="/root/archive.db"
TARGET="$1"

echo -e "\033[38;5;198m============================================================\033[0m"
echo -e "\033[1;36m       🌐 ZIGGYOS OFFLINE WEB BROWSING INTERFACE CORE       \033[0m"
echo -e "\033[38;5;198m============================================================\033[0m"

if [ -z "$TARGET" ]; then
    echo -e "  \033[1;33m[*] Welcome to WorldNet Offline Core. Available Domains:\033[0m"
    if [ -f "$DB" ]; then
        sqlite3 "$DB" "SELECT mask_key FROM bit_packed_net;" 2>/dev/null | sed 's/^/   - http:\/\//;s/$/\.net/'
    fi
    echo -e "\n  \033[93m[-] Usage: surf <domain_or_keyword_name>\033[0m"
    echo -e "\033[38;5;198m============================================================\033[0m"
    exit 0
fi

if [ -f "$DB" ]; then
    # Clean the protocol wrapper string if the user types http://domain.net
    CLEAN_KEY=$(echo "$TARGET" | sed 's/http:\/\///g;s/\.net//g;s/\.com//g')
    
    # Extract the full semantic data body text from our memory registers
    RESULT=$(sqlite3 "$DB" "SELECT vector_payload FROM bit_packed_net WHERE mask_key LIKE '%$CLEAN_KEY%' LIMIT 1;" 2>/dev/null)
    
    if [ ! -z "$RESULT" ]; then
        echo -e "\033[1;32m[+] CONNECTED TO: http://${CLEAN_KEY}.net (RESOLVED OFFLINE)\033[0m"
        echo -e "------------------------------------------------------------"
        echo -e " \033[94m[BROWSER FRAME VIEW]:\033[0m\n"
        echo -e "    $RESULT"
        echo ""
    else
        echo -e "  \033[91m[404] SERVER NOT FOUND: Unable to resolve host offline.\033[0m"
    fi
else
    echo -e "  \033[91m[-] Missing active offline web database cores.\033[0m"
fi
echo -e "\033[38;5;198m============================================================\033[0m"
