with open('master_mesh.py', 'w') as f:
    f.write('''import socket, threading, sys, json, os, time\n
CHUNK = 4096\n
def listen(port, next_hop):\n
    s = socket.socket()\n
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n
    s.bind(('127.0.0.1', port))\n
    s.listen()\n
    while True:\n
        try:\n
            c, _ = s.accept()\n
            rl = b''\n
            while not rl.endswith(b'\\\\n'): rl += c.recv(1)\n
            meta = json.loads(c.recv(int(rl.strip())).decode())\n
            fn = f'recv_{port}_{meta[\"file\"]}' if meta['target'] == port else f'tmp_{port}_{meta[\"file\"]}'\n
            print(f'\\\\n\\\\033[1;33m[NODE-{port}]\\\\033[0m Handled data targeted for Node {meta[\"target\"]}')\n
            with open(fn, 'wb') as out:\n
                rb = 0\n
                while rb < meta['size']:\n
                    chunk = c.recv(min(CHUNK, meta['size'] - rb))\n
                    if not chunk: break\n
                    out.write(chunk)\n
                    rb += len(chunk)\n
            if meta['target'] != port and next_hop:\n
                push_forward(next_hop, meta, fn)\n
                if os.path.exists(fn): os.remove(fn)\n
            elif meta['target'] == port:\n
                print(f'\\\\033[1;32m[LANDED]\\\\033[0m File arrived safely at Destination Node {port} -> {fn}\\\\n>>> ')\n
        except Exception as e: pass\n
def push_forward(hop, meta, fp):\n
    try:\n
        mb = json.dumps(meta).encode()\n
        c = socket.socket(); c.connect(('127.0.0.1', hop))\n
        c.sendall(f'{len(mb)}\\\\n'.encode() + mb)\n
        with open(fp, 'rb') as source:\n
            while chunk := source.read(CHUNK): c.sendall(chunk)\n
        c.close()\n
    except: pass\n
def inject_push(target, fp):\n
    if not os.path.exists(fp): print(f'File {fp} not found'); return\n
    meta = {'target': target, 'file': os.path.basename(fp), 'size': os.path.getsize(fp)}\n
    print(f'\\\\033[1;31m[ORIGIN-5001]\\\\033[0m Injecting asset for Node {target} through mesh gateway...')\n
    push_forward(5002, meta, fp)\n
threading.Thread(target=listen, args=(5003, None), daemon=True).start()\n
threading.Thread(target=listen, args=(5002, 5003), daemon=True).start()\n
threading.Thread(target=listen, args=(5001, 5002), daemon=True).start()\n
time.sleep(0.5)\n
