import socket, selectors, json, os, time, hashlib
P, CHUNK, sel = list(range(7001, 7004)), 4096, selectors.DefaultSelector()
INDEX_PATH = "/root/unlimited_grid_deck/global_master_index.db"
stats = {'indexed_domains': 0, 'index_bytes': 0}
def build_index_node(sock, mask):
    try:
        c, _ = sock.accept(); rl = b''
        while not rl.endswith(b'\n'): rl += c.recv(1)
        meta = json.loads(c.recv(int(rl.strip())).decode())
        
        t0 = time.perf_counter_ns()
        domain = meta.get('domain', 'void.net')
        payload_data = meta.get('text_content', '')
        
        # Calculate sparse base-16 tracking tokens
        dom_hash = hashlib.sha256(domain.encode()).hexdigest()[:16].upper()
        fn = f"idx_block_{dom_hash}"
        
        # Write record line directly to boundless storage track
        with open(INDEX_PATH, 'a') as idx:
            record = f"{dom_hash}:{domain}:{len(payload_data)}\n"
            idx.write(record)
            stats['index_bytes'] += len(record)
            stats['indexed_domains'] += 1
            
        dt = (time.perf_counter_ns() - t0) / 1000
        print(f"\033[1;36m[GLOBAL-INDEX]\033[0m Hashed: \033[1;33m{domain}\033[0m ➔ Sigil: {dom_hash} | Latency: {dt:.1f} us")
        
        c.close()
    except: pass
# Bind Asynchronous Signal Multiplexers to Ingestion Sockets
for p in P:
    s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('127.0.0.1', p)); s.listen(); s.setblocking(False)
    sel.register(s, selectors.EVENT_READ, build_index_node)
print("\033[1;31m[MASTER OFFLINE INDEXER ONLINE]\033[0m Ingestion matrix ready...")
try:
    while True:
        for key, mask in sel.select(timeout=1.0): key.data(key.fileobj, mask)
except KeyboardInterrupt:
    print(f"\n\033[1;32m[INDEX SYNCHRONIZED]\033[0m Total Mapped Domains: {stats['indexed_domains']} | Index Size: {stats['index_bytes']} Bytes")
EOF
