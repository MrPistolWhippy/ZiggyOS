    conn = sqlite3.connect('$DB_PATH')
    cursor = conn.cursor()
    cursor.execute('CREATE TABLE IF NOT EXISTS ingress_network_node (id INTEGER PRIMARY KEY, packet_data TEXT, timestamp TEXT);')
    cursor.execute('DELETE FROM ingress_network_node;')
    regions = ['EU-WEST', 'APAC-EAST', 'LATAM-SOUTH', 'AFRICA-CENTRAL', 'NA-NORTH']
    for i in range(1, 51):
        ip, zone, node = f'192.168.10.{i}', random.choice(regions), f'NODE-INT-{1000 + i}'
        cursor.execute('INSERT INTO ingress_network_node (packet_data, timestamp) VALUES (?, ?);', 
                       (f'NodeID: {node} | Route: [{ip}:9876] | Zone: {zone} | Matrix: SYNCHRONIZED', f'2026-06-14 23:23:{i:02d}'))
    cursor.execute('DROP TABLE IF EXISTS peer_shard_topology;')
    cursor.execute('CREATE TABLE IF NOT EXISTS peer_shard_topology (peer_id TEXT PRIMARY KEY, local_weight REAL, mesh_status TEXT, us_region TEXT);')
    us_zones = ['US-EAST-ATLANTIC', 'US-WEST-PACIFIC', 'US-CENTRAL-PLAINS', 'US-SOUTH-BORDER', 'US-NORTH-LAKES']
    cursor.execute('SELECT id FROM ingress_network_node;')
    nodes = cursor.fetchall()
    for i, row in enumerate(nodes):
        cursor.execute('INSERT INTO peer_shard_topology (peer_id, local_weight, mesh_status, us_region) VALUES (?, ?, ?, ?);', 
                       (f'PEER-NODE-{1000 + row}', round(1.0 / len(nodes), 4), 'PEER_CONNECTED', us_zones[i % len(us_zones)]))
    conn.commit(); conn.close()
except Exception as e: print('[-] US Regional Initialization Error: ' + str(e))
"
