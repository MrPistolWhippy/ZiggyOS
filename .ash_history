        ACTIVE_T=$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM p6_ledger WHERE status='ALARM_RING_ACTIVE';" 2>/dev/null || echo "0")
        TOTAL_P=$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM peer_shard_topology;" 2>/dev/null || echo "0")
        echo -e "  - Chained Blocks Recorded      : ${TEAL}${CHAINED_B} Verified Blocks${RESET}"
