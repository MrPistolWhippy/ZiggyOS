<!DOCTYPE html>
<html>
<head>
<title>Mesh Control</title>
<style>
  body { background:#0b0e14; color:#a2a8b3; font-family:monospace; padding:20px; margin:0; overflow-x:hidden; }
  h1 { color:#ef4444; font-size:18px; margin-bottom:15px; }
  .grid { display:flex; gap:20px; margin-bottom:20px; }
  .card { background:#011322; padding:20px; flex:1; text-align:center; border-radius:8px; border:1px solid #1a2333; }
  .card-teal { border-color:#38bdf8; } h3 { font-size:28px; margin:10px 0; }
  .metric-teal { color:#38bdf8; } .metric-red { color:#ef4444; } .metric-gold { color:#eab308; }
  #box { height:380px; background:#011322; border:1px solid #1a2333; border-radius:8px; position:relative; overflow:hidden; z-index:1; }
  .node { position:absolute; background:#011322; border:2px solid #ef4444; padding:8px; color:#ef4444; font-size:11px; font-weight:bold; cursor:move; border-radius:4px; z-index:10; box-shadow:0 0 8px rgba(239,68,68,0.2); }
  .node-star { border-color:#38bdf8; color:#38bdf8; border-radius:50%; box-shadow:0 0 8px rgba(56,189,248,0.2); }
  #log-panel { height:120px; background:#05070a; border:1px solid #1a2333; border-radius:8px; margin-top:20px; padding:12px; font-size:11px; color:#10b981; overflow-y:auto; line-height:1.5; box-shadow:inset 0 0 10px #000; }
  .log-entry { margin:2px 0; font-weight:bold; } .log-warn { color:#eab308; } .log-crit { color:#ef4444; }
</style>
</head>
<body>
