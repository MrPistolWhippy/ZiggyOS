cat << 'EOF' > /mnt/api_server.py
import sys
import os
import json
import logging
from http.server import BaseHTTPRequestHandler, HTTPServer
# Configure automatic error logging file
logging.basicConfig(
    filename='/mnt/server_errors.log',
    level=logging.ERROR,
    format='%(asctime)s [%(levelname)s] %(message)s'
)
class ZiggyOSHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        # Mute standard console clutter to keep terminal clean
        pass
    def do_POST(self):
        try:
            content_length = int(self.headers['Content-Length'])
            post_data = self.rfile.read(content_length).decode('utf-8')
            
            # Safely handle JSON structures or fall back to raw text
            try:
                data = json.loads(post_data)
                action = data.get("action", "")
            except json.JSONDecodeError:
                action = post_data # Fallback if raw text string sent
            if action == "node_intercept":
                response = {"status": "SUCCESS", "log": "[MESH EVENT] Interfaced directly with node."}
            elif action == "clear_cache":
                response = {"status": "SUCCESS", "log": "[L1H KERNEL] Memory Cache Buffers Purged Cleanly."}
            elif action == "sys_reboot":
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"status": "SUCCESS", "log": "[KERNEL] Executing system runtime reload..."}).encode())
                os.system("pkill -f python3")
                sys.exit(0)
            else:
                raise ValueError(f"Unknown pipeline action sequence: {action}")
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps(response).encode())
        except Exception as e:
            # Automatically catch and log errors to the file instead of breaking the script
            logging.error(f"Handler Crash: {str(e)} | Raw Payload: {post_data if 'post_data' in locals() else 'None'}")
            self.send_response(500)
            self.end_headers()
            self.wfile.write(b'{"status": "ERROR", "message": "Internal Pipeline Exception Logged"}')
if __name__ == '__main__':
    try:
        server = HTTPServer(('0.0.0.0', 8080), ZiggyOSHandler)
        print("[INTEGRATION ENGAGED] API Command Pipeline Listening over Port 8080...")
        server.serve_forever()
    except Exception as server_error:
        logging.critical(f"Server Core Failure: {str(server_error)}")
EOF
cat << 'EOF' > /mnt/dashboard_panel.html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>ZIGGY-OS PEER MESH LAYER</title>
    <style>
        body { background-color: #0d0f12; color: #cbd5e1; font-family: monospace; margin: 0; padding: 20px; }
        .header { border-bottom: 2px solid #ef4444; padding-bottom: 10px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; }
        .critical-title { color: #ef4444; font-weight: bold; font-size: 1.2rem; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; margin-bottom: 20px; }
        .card { background: #1e293b; border: 1px solid #334155; padding: 15px; border-radius: 4px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.5); }
        .card-title { color: #94a3b8; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 5px; }
        .card-value { font-size: 1.8rem; font-weight: bold; color: #38bdf8; }
        .card-value.alert { color: #f87171; }
