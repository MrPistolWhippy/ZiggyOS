    get_latest_silicon_metrics
    echo -e "\033[38;5;198m------------------------------------------------------------\033[0m"
    
    echo -e "\033[1;36m🌲 SYSTEM DATA-FLOW ARCHITECTURE TOPOLOGY MAP:\033[0m"
    echo -e "   [ANTENNA RF FRONT-END] ──► [sat_socket.py INTERCEPT CORE]"
