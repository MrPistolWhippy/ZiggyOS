<script>
let bl=document.getElementById('b'),ve=document.getElementById('v'),sh=document.getElementById('s'),l=document.getElementById('l'),t=document.getElementById('t'),sel=document.getElementById('sel'),cv=document.getElementById('c'),c=cv.getContext('2d'),bdy=document.getElementById('bdy');
let activeNode="None",alertMode=false,n=[{n:"Loopin",x:250,y:100,c:"#38bdf8"},{n:"US-E",x:400,y:50,c:"#4ade80"},{n:"US-W",x:100,y:60,c:"#f87171"},{n:"US-S",x:250,y:170,c:"#4ade80"}];
setInterval(async ()=>{
    try { let res=await fetch('/api/metrics'),d=await res.json(); bl.innerText=d.blocks.toLocaleString(); ve.innerText=d.vectors; sh.innerText=d.shards; } catch(e){}
},1000);
// SSE Tunnel Handler targeting red alert flashes
const eventSource = new EventSource('/api/stream');
eventSource.onmessage = (e) => {
    let data = JSON.parse(e.data);
    if(data.type === "alert") { alertMode = true; l.innerHTML += `<div style="color:#ef4444;font-weight:bold">${data.msg}</div>`; }
    else { l.innerHTML += `<div>${data.msg}</div>`; }
    l.scrollTop = l.scrollHeight;
};
// Background loop to flash window canvas bright crimson during overload state
