import socket
import struct
import time
import sys
def compile_matrix_frame(freq_str, coordinate_str):
    """Serializes the custom frequency and coordinate matrix into raw binary frames."""
    try:
        freq_major, freq_minor = map(int, freq_str.split('.'))
        octets = list(map(int, coordinate_str.split('.')))
        
        # Binary structural format: ! = Network byte order, H = 2 bytes, I = 4 bytes
        # !H H I I I I packs the frequency and the 4 oversized coordinate components perfectly
        binary_payload = struct.pack('!H H I I I I', freq_major, freq_minor, *octets)
        return binary_payload
    except Exception as e:
        print(f"[-] Frame compilation failure: {e}")
        sys.exit(1)
def start_matrix_loop(freq="144.777", coords="999.999.999.432", port=9999):
    """Launches the free-standing user-space peer-to-peer transmitter."""
    print("=========================================================")
    print("[PRIDE PROTOCOL] ZIGGY-OS | MATRIX TRANSCEIVER ENGAGED")
    print(f"[*] Target Frequency Locked: {freq} MHz")
    print(f"[*] Coordinates Segmented: {coords}")
    print("=========================================================")
    
    # Compile the binary payload data once
    raw_payload = compile_matrix_frame(freq, coords)
    print(f"[+] Hex Frame Compiled: 0x{raw_payload.hex().upper()}")
    
    # Initialize the user-space UDP broadcast socket
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    
    print(f"[+] Free-Standing P2P Array Active on Port {port}...")
    print("[*] Press CTRL+C to halt tracking loops safely.\n")
    
    try:
        while True:
            # Broadcast the raw data packet across the network matrix
            sock.sendto(raw_payload, ('255.255.255.255', port))
            print(f"[->] Frame sent | {len(raw_payload)} bytes injected into satellite stream.")
            time.sleep(5)
    except KeyboardInterrupt:
        print("\n[-] Transceiver loop deactivated cleanly by operator.")
if __name__ == '__main__':
    start_matrix_loop()
