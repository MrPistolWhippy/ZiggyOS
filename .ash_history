cat << 'EOF' > fast_build.sh
#!/bin/bash
set -e
echo "==> Fast-searching known GitHub action toolchain workspaces..."
# Looks specifically inside runner and opt directories for speed
COMPILER_PATH=$(find /home/runner /opt /usr/local -name "riscv64-unknown-elf-gcc" -o -name "riscv32-unknown-elf-gcc" 2>/dev/null | head -n 1)
if [ -z "$COMPILER_PATH" ]; then
    echo "⚠️ Not found in standard CI locations. Trying rapid fallback..."
    COMPILER_PATH=$(which riscv64-unknown-elf-gcc || which riscv32-unknown-elf-gcc || find / -maxdepth 3 -name "*riscv*gcc" 2>/dev/null | head -n 1)
fi
if [ -z "$COMPILER_PATH" ]; then
    echo "❌ Error: Toolchain binaries are not accessible in this debug shell environment."
    exit 1
fi
TOOLCHAIN_BIN_DIR=$(dirname "$COMPILER_PATH")
BINARY_NAME=$(basename "$COMPILER_PATH")
echo "✅ Found compiler at: $COMPILER_PATH"
export PATH="$TOOLCHAIN_BIN_DIR:$PATH"
echo "==> Adjusting source file headers..."
sed -i 's/#include <stdio.h>/\/\/ #include <stdio.h>/g' riscv_driver.c
echo "==> Compiling freestanding..."
$BINARY_NAME -march=rv32i -mabi=ilp32 -ffreestanding -nostdlib riscv_driver.c watchdog.o -o riscv_test_bench
echo "🎉 Build successful!"
EOF
chmod +x fast_build.sh && ./fast_build.sh
cat << 'EOF' > finish_build.sh
#!/bin/bash
set -e
# 1. Update our PATH to use the discovered toolchain location
export PATH="/usr/bin:$PATH"
# 2. Inject a custom bare-metal print implementation into the top of the C driver file
# This resolves the undefined reference error without relying on standard C libraries
cat << 'C_EOF' > patch.c
// Custom minimal bare-metal print stub for compilation resolution
void print(const char *str) {
    // In actual hardware, you would loop and write to a UART TX register here
    while (*str) {
        volatile char *uart_tx = (volatile char *)0x10000000; // Example MMIO UART address
        *uart_tx = *str++;
    }
}
C_EOF
# Combine our patch with the original file (ignoring the missing stdio header)
grep -v "#include <stdio.h>" riscv_driver.c > temporary_driver.c
cat patch.c temporary_driver.c > finalized_driver.c
echo "==> Compiling freestanding bare-metal RISC-V binary..."
riscv-none-elf-gcc -march=rv32i -mabi=ilp32 -ffreestanding -nostdlib finalized_driver.c watchdog.o -o riscv_test_bench
echo "🎉 Build successful! 'riscv_test_bench' generated."
# Clean up temporary working files
rm -f patch.c temporary_driver.c finalized_driver.c
EOF
chmod +x finish_build.sh && ./finish_build.sh
