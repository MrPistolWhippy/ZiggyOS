  <script>
    // Embedded dragging script that requires zero external files or library links
    const container = document.getElementById('canvas-container');
    const nodes = document.querySelectorAll('.node');
    let activeNode = null; let offsetX = 0; let offsetY = 0;
    nodes.forEach(node => {
      node.addEventListener('mousedown', startDrag);
      node.addEventListener('touchstart', startDrag, { passive: false });
    });
    function startDrag(e) {
      activeNode = e.target.closest('.node');
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      const rect = activeNode.getBoundingClientRect();
      offsetX = clientX - rect.left;
      offsetY = clientY - rect.top;
      
      document.addEventListener('mousemove', drag);
