cat << 'EOF' > z_horizon.py
import socket, selectors, json, os, time, hashlib
P, CHUNK, sel, stats = list(range(7001, 7004)), 4096, selectors.DefaultSelector(), {}
for p in P: stats[p] = {'blocks': 0, 'bytes': 0, 'latency_us': 0.0}
def handle_unredacted_frame(sock, mask):
    try:
        c, _ = sock.accept(); rl = b''
        while not rl.endswith(b'\n'): rl += c.recv(1)
        meta = json.loads(c.recv(int(rl.strip())).decode())
        p = sock.getsockname(); fn = f"/root/unlimited_grid_deck/p2p_{p}_{meta['file']}"
        
        t0 = time.perf_counter_ns()
        
        # Zero-Copy Reference Swap Operation (Redesigned Memory Pathway)
        if meta.get('from_path') and os.path.exists(meta['from_path']) and meta['target'] == p:
            os.replace(meta['from_path'], fn); stats[p]['bytes'] += meta['size']
        else:
            with open(fn, 'wb') as o:
                rb = 0
                while rb < meta['size']:
                    k = c.recv(min(CHUNK, meta['size'] - rb)); o.write(k); rb += len(k)
                    stats[p]['bytes'] += len(k); stats[p]['blocks'] += 1
                    
        dt = (time.perf_counter_ns() - t0) / 1000; stats[p]['latency_us'] = dt
        h = hashlib.sha256()
        with open(fn, 'rb') as f:
            while chunk := f.read(CHUNK): h.update(chunk)
            
        print(f"\033[1;31m[OFFLINE-GATEWAY]\033[0m Node {p} ➔ Handled: {meta['file']} | Latency: {dt:.1f} us | Cryptography: {h.hexdigest()[:12].upper()}...")
        
        if meta['target'] != p:
            nxt = 7002 if p == 7001 else 7003; meta['from_path'] = fn
            sk = socket.socket(); sk.connect(('127.0.0.1', nxt)); mb = json.dumps(meta).encode()
            sk.sendall(f"{len(mb)}\n".encode() + mb); sk.close(); os.remove(fn)
        c.close()
    except: pass
for p in P:
    s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('127.0.0.1', p)); s.listen(); s.setblocking(False)
    sel.register(s, selectors.EVENT_READ, handle_unredacted_frame)
print("\033[1;32m[OFFLINE PATHWAY ACTIVE]\033[0m Awaiting peer frame injection blocks...")
while True:
    for key, mask in sel.select(timeout=1.0): key.data(key.fileobj, mask)
