cat << 'EOF' > pipeline.py
import socket, threading, sys, json, os, time
PORT = int(sys.argv[1])
PEERS = [int(p) for p in sys.argv[2].split(',') if p] if len(sys.argv) > 2 else []
CHUNK_SIZE = 4096
def log(tag, text, color="31"):
    print(f"\033[1;{color}m[{tag}]\033[0m {text}")
def listen():
    s = socket.socket()
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('127.0.0.1', PORT))
    s.listen(5)
    log("ONLINE", f"Asset pipeline active on port {PORT}", "32")
    while True:
        try:
            conn, _ = s.accept()
            threading.Thread(target=handle_incoming, args=(conn,), daemon=True).start()
        except: break
def handle_incoming(conn):
    try:
        header_bytes = conn.recv(128).decode().strip()
        if not header_bytes: return
        meta = json.loads(header_bytes)
        
        filename = f"recv_{PORT}_{meta['file']}"
        size = meta['size']
        log("PIPELINE-IN", f"Streaming '{meta['file']}' ({size} bytes) from Node {meta['from']}")
        
        bytes_received = 0
        with open(filename, 'wb') as f:
            while bytes_received < size:
                chunk = conn.recv(min(CHUNK_SIZE, size - bytes_received))
                if not chunk: break
                f.write(chunk)
                bytes_received += len(chunk)
        
        log("SUCCESS", f"Asset '{filename}' fully reconstructed.", "32")
    except Exception as e:
        log("STREAM-ERROR", str(e))
    finally: conn.close()
def push_asset(target_port, filepath):
    if not os.path.exists(filepath):
        log("ERROR", f"File '{filepath}' not found locally.")
        return
    try:
        size = os.path.getsize(filepath)
        filename = os.path.basename(filepath)
        meta = json.dumps({"from": PORT, "file": filename, "size": size})
        header = meta.ljust(128)[:128].encode()
        
        c = socket.socket()
        c.connect(('127.0.0.1', target_port))
        c.sendall(header)
        
        log("PIPELINE-OUT", f"Pushing '{filename}' to node {target_port}...")
        with open(filepath, 'rb') as f:
            while chunk := f.read(CHUNK_SIZE):
                c.sendall(chunk)
        log("SUCCESS", f"Asset '{filename}' pushed successfully.", "32")
        c.close()
    except Exception as e:
        log("LINK-FAILED", f"Could not stream to port {target_port}: {e}")
threading.Thread(target=listen, daemon=True).start()
time.sleep(0.2)
locals_env = {"push": push_asset, "PORT": PORT, "PEERS": PEERS}
import code
code.interact(banner="\033[1;33m[ZIGGYOS MANIFEST ENGINE LIVE] Use push(target_port, 'file.bin')\033[0m", local=locals_env)
EOF
