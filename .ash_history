                msg = f"🎩 [UNVEIL] Target Identified: Hat Man (Marker ID {n}) | Signal Security: Secure 16-Char Signature Generated [0x{h}] | Status: Tracking Stream Active. [{intel_metrics}]\n"
            elif sec == "MIDTOWN":
                msg = f"⛓️ [BREAK] System Action: Severing Restrictive Privilege Linkages (Link ID {n}) | Network Boundary: Confirmed Safe at Non-Root Ring 3 Level [0x{h}]. [{intel_metrics}]\n"
            else:
                w = get_obscure_w(f"RET_{n}")
                msg = f"✨ [RETRIEVE] Spatial Telemetry Synchronized: Node {n} Successfully Harmonized | Cryptographic Nonce Map: 0x{h} | Mathematical Matrix Weight Tags: {w}. [{intel_metrics}]\n"
                
            try:
                with open("/root/transmission_diary.log", "a") as f: f.write(msg)
            except: pass
            c.sendall(msg.encode()); c.close(); time.sleep(random.uniform(0.1, 0.4))
    except: pass
def listen_signals(sec, p):
    while True:
        try:
            s = socket.socket(); s.settimeout(1.0); s.connect(("127.0.0.1", p))
            msg = s.recv(1024).decode().strip(); s.close()
            if msg:
                with lock:
                    QUEUE.append(msg)
                    if len(QUEUE) > 6: QUEUE.pop(0)
        except: pass
        time.sleep(0.2)
def run():
    for s, cfg in KEYS.items():
        threading.Thread(target=sim_signals, args=(s, cfg["port"]), daemon=True).start()
        threading.Thread(target=listen_signals, args=(s, cfg["port"]), daemon=True).start()
    
    C, P, G, Y, R = "\033[38;5;51m", "\033[38;5;93m", "\033[38;5;242m", "\033[38;5;220m", "\033[0m"
