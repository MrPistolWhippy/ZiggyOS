#!/usr/bin/env python3
import sys, socket, threading, time, random, hashlib
KEYS = {
    "DOWNTOWN": {"port": 44901, "f": "Hat Man Tracking"},
    "MIDTOWN":  {"port": 44902, "f": "Empire Chains"},
    "UPTOWN":   {"port": 44903, "f": "Obscure Retrieval"}
}
