python3 -c "
import sqlite3, hashlib
try:
    conn = sqlite3.connect('/root/archive.db')
    cursor = conn.cursor()
    
    # Define detailed parameters for Roermond and the expanded international endpoints
    new_global_nodes = [
        ('PEER-NL-ROERMOND-1', 'NL-EUROPE-NORTH', 'x86_64/kvm-core', 7010),
        ('PEER-NL-ROERMOND-2', 'NL-EUROPE-NORTH', 'aarch64/soc-node', 7011),
        ('PEER-NL-ROERMOND-3', 'NL-EUROPE-NORTH', 'riscv64/embedded', 7012),
        ('PEER-GLOBAL-CORE-1', 'GL-MESH-BACKBONE', 'x86_64/kvm-core', 8001),
        ('PEER-GLOBAL-CORE-2', 'GL-MESH-BACKBONE', 'aarch64/soc-node', 8002)
    ]
    
    for name, region, hw, chan in new_global_nodes:
        sig = hashlib.sha256(f'{name}_{chan}'.encode()).hexdigest()[:16]
        
        # Insert nodes into topology, layered metadata, and the nested swarm manifest simultaneously
        cursor.execute('INSERT OR REPLACE INTO peer_shard_topology (peer_id, local_weight, mesh_status, us_region) VALUES (?, 0.0800, \'PEER_CONNECTED\', ?);', (name, region))
        cursor.execute('INSERT OR REPLACE INTO peer_layered_metadata (peer_id, hw_arch, layer_crypto_sig, tracking_channel) VALUES (?, ?, ?, ?);', (name, hw, sig, chan))
        cursor.execute('INSERT OR REPLACE INTO swarm_manifest (node_id, nested_status, loop_count) VALUES (?, \'SWARM_NESTED_ACTIVE\', 777);')
        
    conn.commit(); conn.close()
    print('\033[92m[+] SUCCESS: ROERMOND NODES & GLOBAL BACKBONE INFRASTRUCTURE INJECTED\033[0m')
except Exception as e:
    print('[-] Grid Extension Interrupted: ' + str(e))
"
