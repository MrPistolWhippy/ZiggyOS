#!/bin/bash
set -e
echo "==> Removing stdio dependency from driver..."
# Comment out the #include <stdio.h> line in your source file
sed -i 's/#include <stdio.h>/\/\/ #include <stdio.h>/g' riscv_driver.c
echo "==> Compiling freestanding bare-metal binary..."
# -ffreestanding: compilation takes place in a thin embedded environment
# -nostdlib: do not use the system standard startup files or libraries
riscv64-unknown-elf-gcc -march=rv32i -mabi=ilp32 -ffreestanding -nostdlib riscv_driver.c watchdog.o -o riscv_test_bench
echo "==> Build successful!"
EOF
