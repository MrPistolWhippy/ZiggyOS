import socket, threading, json, os, time, sys
P, HOP, CHUNK, stats = 7001, 7002, 4096, {'pkts': 0, 'bytes': 0, 'files': []}
def listen():
    s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('127.0.0.1', P)); s.listen()
    while True:
        try:
            c, _ = s.accept(); rl = b''
            while not rl.endswith(b'\n'): rl += c.recv(1)
            meta = json.loads(c.recv(int(rl.strip())).decode())
            fn = f"tel_tmp_{P}_{meta['file']}"
            print(f"\n\033[1;33m[UNPACK]\033[0m Receiving: {meta['file']} targeting Node {meta['target']}")
            with open(fn, 'wb') as out:
                rb = 0
                while rb < meta['size']:
                    k = c.recv(min(CHUNK, meta['size'] - rb)); out.write(k); rb += len(k)
                    stats['bytes'] += len(k); stats['pkts'] += 1
            if meta['file'] not in stats['files']: stats['files'].append(meta['file'])
            if meta['target'] != P:
                push_out(HOP, meta, fn); os.remove(fn)
            else: print(f"\033[1;32m[LANDED]\033[0m Asset saved locally -> {fn}\n>>> ", end="")
        except: pass
def push_out(hop, meta, fp):
    try:
        mb = json.dumps(meta).encode(); sk = socket.socket(); sk.connect(('127.0.0.1', hop))
        sk.sendall(f"{len(mb)}\n".encode() + mb)
        with open(fp, 'rb') as f:
            while chunk := f.read(CHUNK): sk.sendall(chunk)
        sk.close(); print(f"\033[1;34m[RELAY]\033[0m Passed to Node {hop}\n>>> ", end="")
    except: print(f"\n\033[1;31m[LINK-FAILED]\033[0m Port {hop} unreachable.\n>>> ", end="")
def inject(target, fp):
    if not os.path.exists(fp): print(f"File {fp} not found"); return
    meta = {'target': target, 'file': os.path.basename(fp), 'size': os.path.getsize(fp)}
    push_out(P, meta, fp)
def view(): print(f"\n\033[1;36m[STATS]\033[0m Packets: {stats['pkts']} | Volume: {stats['bytes']} Bytes | Files: {stats['files']}\n>>> ")
threading.Thread(target=listen, daemon=True).start(); time.sleep(0.1)
print('\033[1;32m[DASHBOARD ONLINE]\033[0m Use: push(7003, "system.img") or dashboard()')
import code; code.interact(banner="", local={'push': inject, 'dashboard': view, 'stats': stats})
