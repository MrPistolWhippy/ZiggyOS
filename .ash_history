import sqlite3, random
try:
    conn = sqlite3.connect('/root/archive.db')
    cursor = conn.cursor()
    
    # Restructure peer sharding configurations to align with USA geography
    cursor.execute('DROP TABLE IF EXISTS peer_shard_topology;')
    cursor.execute('CREATE TABLE IF NOT EXISTS peer_shard_topology (peer_id TEXT PRIMARY KEY, local_weight REAL, mesh_status TEXT, us_region TEXT);')
    
    # 5 Regions mapping out the entire geographic scope of the United States
    us_zones = ['US-EAST-ATLANTIC', 'US-WEST-PACIFIC', 'US-CENTRAL-PLAINS', 'US-SOUTH-BORDER', 'US-NORTH-LAKES']
    
    # Query your 50 live provisioned tracking nodes
    cursor.execute('SELECT id FROM ingress_network_node;')
    nodes = cursor.fetchall()
    
    if not nodes:
        print('[-] Database empty. Run ash /root/master_autonomous_engine.sh first.')
        sys.exit(1)
        
    for i, row in enumerate(nodes):
        node_num = row[0]
        peer_id = f'PEER-NODE-{1000 + node_num}'
        
        # Distribute the 50 nodes evenly (10 per US region cluster zone)
        assigned_region = us_zones[i % len(us_zones)]
        even_weight = round(1.0 / len(nodes), 4)
        
        cursor.execute('INSERT INTO peer_shard_topology (peer_id, local_weight, mesh_status, us_region) VALUES (?, ?, ?, ?);', 
                       (peer_id, even_weight, 'PEER_CONNECTED', assigned_region))
        
    conn.commit()
    conn.close()
    print('\033[92m[+] SUCCESS: 50 NODES DISTRIBUTED EVENLY ACROSS 5 GEOGRAPHIC US REGIONS\033[0m')
except Exception as e:
    print('[-] US Regional Mapping Interrupted: ' + str(e))
