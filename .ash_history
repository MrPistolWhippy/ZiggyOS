apk add gcc-riscv64-none-elf newlib-riscv64-none-elf || apk add gcc g++
# 2. Establish a system shortcut alias so 'riscv64-unknown-elf-gcc' is discovered instantly
ln -sf /usr/bin/riscv64-none-elf-gcc /usr/bin/riscv64-unknown-elf-gcc
echo "==> Stripping environment header blocks..."
