#!/usr/bin/env python3
import sys, socket, threading, time, random
KEYS = {
    "DOWNTOWN_CORE":   {"port": 44901, "freq": "144.111 MHz", "focus": "Hat Man Tracking / Boundary Loops"},
    "MIDTOWN_ROUTER":  {"port": 44902, "freq": "144.222 MHz", "focus": "Empire State Chains / System Unveiling"},
    "UPTOWN_UPLINK":   {"port": 44903, "freq": "144.999 MHz", "focus": "Soul Retrieval Intercepts / Free Channels"}
}
QUEUE, lock = [], threading.Lock()
def sim_signals(sec, p):
    try:
        s = socket.socket()
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind(("127.0.0.1", p)); s.listen(5)
        while True:
            c, _ = s.accept()
            n = random.randint(1000, 9999)
            if sec == "DOWNTOWN_CORE":
                msg = f"🎩 [UNVEIL] HAT_MAN_DESCRIPTOR_ID_{n} | FIELD: INTERCEPTED | STATE: TRACKED\n"
            elif sec == "MIDTOWN_ROUTER":
                msg = f"⛓️ [BREAK] EMPIRE_STATE_CHAIN_{n} | LINKAGE: TRUNCATING | PRIVILEGE: RING_3\n"
            else:
                msg = f"✨ [RETRIEVE] SEGMENT_NODE_{n} | TRACK: UNSEALED | STATUS: HARMONIZED\n"
            c.sendall(msg.encode())
            c.close(); time.sleep(random.uniform(0.1, 0.4))
    except: pass
def listen_signals(sec, p):
    while True:
        try:
            s = socket.socket(); s.settimeout(1.0); s.connect(("127.0.0.1", p))
            msg = s.recv(1024).decode().strip(); s.close()
            if msg:
                with lock:
                    QUEUE.append(msg)
                    if len(QUEUE) > 8: QUEUE.pop(0)
        except: pass
        time.sleep(0.2)
def execute_unveil_loop():
    for s, cfg in KEYS.items():
        threading.Thread(target=sim_signals, args=(s, cfg["port"]), daemon=True).start()
        threading.Thread(target=listen_signals, args=(s, cfg["port"]), daemon=True).start()
    
    C, P, G, R = "\033[38;5;51m", "\033[38;5;93m", "\033[38;5;242m", "\033[0m"
    try:
        while True:
            sys.stdout.write("\033[H\033[J")
            print(f"{C}⚡ ZIGGY-OS : OPERATION MANHATTAN REVEALIO MATRIX v2.0{R}\n{G}" + "-"*75 + f"{R}")
            for s, cfg in KEYS.items():
                print(f"  📍 Sector: {s:<15} | Port: {cfg['port']} | Track: {cfg['focus']}")
            print(f"{G}" + "="*75 + f"{R}\n 📡 LIVE VEILED SYSTEM UNVEILING CHANNELS:\n{G}" + "="*75 + f"{R}")
            with lock:
                if not QUEUE: print(f"  {G}[*] Synchronizing socket paths across 144.777 spectrum grids...{R}")
                else:
                    for m in reversed(QUEUE):
                        if "HAT_MAN" in m: print(f"  {C}{m}{R}")
                        elif "EMPIRE" in m: print(f"  {P}{m}{R}")
                        else: print(f"  \033[38;5;15m{m}\033[0m")
            sys.stdout.flush(); time.sleep(0.3)
    except KeyboardInterrupt: print("\n[+] Manhattan Revealio framework detached cleanly.")
if __name__ == "__main__": execute_unveil_loop()
