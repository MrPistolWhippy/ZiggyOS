                    k = c.recv(min(CHUNK, meta['size'] - rb)); o.write(k); rb += len(k)
                    stats[p]['bytes'] += len(k); stats[p]['frames'] += 1
                    
        dt = (time.perf_counter_ns() - t0) / 1000; stats[p]['latency_us'] = dt
        h = hashlib.sha256()
        with open(fn, 'rb') as f:
            while chunk := f.read(CHUNK): h.update(chunk)
            
        print(f"\033[1;35m[HW-INGRESS]\033[0m Node {p} ➔ Raw Data Decoded | Latency: {dt:.1f} us | SHA: \033[1;32m{h.hexdigest()[:10]}\033[0m")
        
        if meta['target'] != p:
