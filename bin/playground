#!/bin/sh
# ==============================================================================
#  THEOSI ZIGGYOS DEFINITIVE UNIFIED PLAYGROUND ORCHESTRATOR
# ==============================================================================
C="/root/modules/ziggy_fpga_core.v"
D="/root/archive.db"

echo -e "\033[38;5;198m============================================================\033[0m"
echo -e "\033[1;36m           THEOSI ZIGGYOS UNIFIED MONOLITH PLAYGROUND       \033[0m"
