void print(const char *s) { while(*s) { *(volatile char *)0x10000000 = *s++; } }
void printf(const char *fmt, ...) { print(fmt); }
void _start(void) { main(); while(1); }
C_EOF
# 3. Strip missing include files
grep -v "stdio.h" riscv_driver.c > cleaned_driver.c
cat patch_symbols.c cleaned_driver.c > unified_src.c
echo "==> Compiling with uniform 32-bit hard-float ABI targets..."
# Changed -mabi=ilp32 to -mabi=ilp32f to fix the float module mismatch error
riscv-none-elf-gcc -march=rv32if -mabi=ilp32f -ffreestanding -nostdlib unified_src.c watchdog.o -o riscv_test_bench
echo "🎉 Linker execution successful!"
rm -f patch_symbols.c cleaned_driver.c unified_src.c
EOF
