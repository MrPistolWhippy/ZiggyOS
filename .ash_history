cat << 'EOF' > /mnt/api_server.py
import sys, os, json, random
from http.server import BaseHTTPRequestHandler, HTTPServer
# Global cluster database state
db = {"blocks": 1540, "vectors": 3, "shards": 53, "last_click": "None"}
class ZiggyOSHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args): pass
    
    def do_GET(self):
        if self.path == '/':
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.send_header('Cache-Control', 'no-store, no-cache, must-revalidate')
            self.end_headers()
            with open('/mnt/dashboard_panel.html', 'rb') as f: self.wfile.write(f.read())
        elif self.path == '/api/metrics':
            # Send current database metrics to Safari
            db["blocks"] += random.randint(0, 2) # continuous background block growth
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps(db).encode())
    def do_POST(self):
        content_length = int(self.headers['Content-Length'])
        post_data = self.rfile.read(content_length).decode('utf-8')
        try:
            data = json.loads(post_data)
            # Handle node click events fired from the HTML Canvas
            if "clicked_node" in data:
                db["last_click"] = data["clicked_node"]
                print(f"\n[NODE EVENT] Max clicked cluster node: {data['clicked_node']}")
                sys.stdout.flush()
                res = {"status": "ACKNOWLEDGED"}
            else:
                res = {"status": "UNKNOWN"}
        except:
            res = {"status": "ERROR"}
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.end_headers()
        self.wfile.write(json.dumps(res).encode())
if __name__ == '__main__':
    HTTPServer(('0.0.0.0', 8080), ZiggyOSHandler).serve_forever()
EOF
cat << 'EOF' > /mnt/dashboard_panel.html
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"></head>
<body style="background:#0d0f12;color:#cbd5e1;font-family:monospace;padding:20px;user-select:none">
<h2 style="color:#ef4444;margin-top:0">[CRITICAL OVERRIDE ACTIVE // ENG: MAX]</h2>
<div style="display:flex;gap:20px;font-size:1.5rem;margin:20px 0">
<div>📦 <span id="b">--</span> Blocks</div>
<div style="color:#f87171">⚠️ <span id="v">--</span> Vectors</div>
<div>🌐 <span id="s">--</span> Shards</div>
</div>
<h3>Topology Grid & Alarm Logs <span id="sel" style="color:#38bdf8;font-size:0.9rem;margin-left:15px"></span></h3>
<canvas id="c" width="500" height="200" style="background:#0a0c10;border:1px solid #ef4444;border-radius:4px;cursor:pointer"></canvas>
<div id="l" style="background:#000;padding:10px;height:120px;overflow-y:auto;color:#4ade80;margin-top:10px;border-radius:4px;font-size:0.85rem"></div>
<script>
let bl=document.getElementById('b'),ve=document.getElementById('v'),sh=document.getElementById('s'),l=document.getElementById('l'),sel=document.getElementById('sel'),cv=document.getElementById('c'),c=cv.getContext('2d');
let activeNode = "None";
let n=[{n:"Loopin",x:250,y:100,c:"#38bdf8"},{n:"US-E",x:400,y:50,c:"#4ade80"},{n:"US-W",x:100,y:60,c:"#f87171"},{n:"US-S",x:250,y:170,c:"#4ade80"}];
// Link 1: AJAX Fetch Data Link script
setInterval(async ()=>{
    try {
        let res = await fetch('/api/metrics');
        let data = await res.json();
        bl.innerText = data.blocks.toLocaleString();
        ve.innerText = data.vectors;
        sh.innerText = data.shards;
    } catch(e){}
    if(Math.random()<0.08){l.innerHTML+=`<div>[${new Date().toLocaleTimeString()}] [WARN] Transmission variance tracked.</div>`;l.scrollTop=l.scrollHeight;}
},1000);
function draw(){
    c.clearRect(0,0,500,200);
    c.strokeStyle='#1e293b';c.lineWidth=0.5;
    for(let i=0;i<500;i+=20){c.beginPath();c.moveTo(i,0);c.lineTo(i,200);c.stroke();}
    for(let j=0;j<200;j+=20){c.beginPath();c.moveTo(0,j);c.lineTo(500,j);c.stroke();}
    n.forEach(i=>{c.strokeStyle=i.n===activeNode?'#38bdf8':'#334155';c.lineWidth=i.n===activeNode?3:1.5;c.beginPath();c.moveTo(250,100);c.lineTo(i.x,i.y);c.stroke();});
    n.forEach(i=>{
        c.fillStyle=i.c;c.beginPath();c.arc(i.x,i.y,i.n===activeNode?10:6,0,7);c.fill();
        c.fillStyle=i.n===activeNode?'#38bdf8':'#fff';c.fillText(i.n,i.x+12,i.y+4);
    });
}
setInterval(draw,50);
// Link 2: Interactive Mouse/Touch click coordinate collision detector
cv.addEventListener('click', (e) => {
    let rect = cv.getBoundingClientRect();
    let x = (e.clientX - rect.left) * (cv.width / rect.width);
    let y = (e.clientY - rect.top) * (cv.height / rect.height);
    n.forEach(node => {
        let dist = Math.sqrt((x-node.x)**2 + (y-node.y)**2);
        if(dist < 15) { // Click radius boundary hit
            activeNode = node.n;
            sel.innerText = `// SELECTED NODE: ${node.n.toUpperCase()}`;
            l.innerHTML += `<div style="color:#38bdf8">[${new Date().toLocaleTimeString()}] [INT] Interfaced directly with ${node.n} Shard Layer</div>`;
            l.scrollTop = l.scrollHeight;
            // Push event tracking packet to Python terminal stdout
            fetch('/', {method:'POST', body: JSON.stringify({clicked_node: node.n})});
        }
    });
});
</script></body></html>
EOF
