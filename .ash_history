: STREAM-AUDIT ( -- )
    \ Main execution loop loop for continuous node verification
    BEGIN
        RECV-BLOCK         \ Read incoming data frame block from left neighbor
        EX_HASH @          \ Fetch our local expected token parameter
        CALC-STEP          \ Process XOR comparison check
        DUP 0= IF          \ Double-check for 0-distance perfect match
