    mcopy -o -i "$TARGET_IMG" /root/layered_peer_manifest.txt ::/layered_peer_manifest.txt 2>/dev/null
    rm -f /root/layered_peer_manifest.txt
fi
# 3. Securely clone your visual HTML dashboards and easy-to-read reports into the FAT container
if [ -f "$HTML_PATH" ]; then
    mcopy -o -i "$TARGET_IMG" "$HTML_PATH" ::/dashboard_panel.html 2>/dev/null
fi
if [ -f "$REPORT_PATH" ]; then
    mcopy -o -i "$TARGET_IMG" "$REPORT_PATH" ::/system_debrief.txt 2>/dev/null
fi
if [ -f "$LEO_REPORT" ]; then
    mcopy -o -i "$TARGET_IMG" "$LEO_REPORT" ::/leo_shareable_report.txt 2>/dev/null
fi
echo -e "\033[92m[+] SUCCESS: ALL CYBERPUNK VISUAL REPORTS MIRRORED SECURELY TO AIR-GAPPED FAT STORAGE\033[0m"
EOF
