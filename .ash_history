<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"></head>
<body id="o" style="background:#0d0f12;color:#cbd5e1;font-family:monospace;padding:20px;user-select:none">
<h2 style="color:#ef4444;margin:0;font-size:1.8rem">[CRITICAL OVERRIDE ACTIVE // ENG: MAX]</h2>
<div style="display:flex;gap:30px;font-size:2.2rem;margin:25px 0;font-weight:bold">
<div>📦 <span id="b">1,540</span> Blocks</div><div style="color:#f87171">⚠️ <span id="v">3</span> Vectors</div><div>🌐 <span id="s">53</span> Shards</div>
</div>
<canvas id="c" width="500" height="200" style="background:#0a0c10;border:2px solid #ef4444;border-radius:4px"></canvas>
<div style="display:flex;gap:10px;margin-top:12px;width:504px">
<div id="l" style="background:#000;padding:10px;height:120px;width:60%;overflow-y:auto;color:#4ade80;font-size:0.9rem;border:1px solid #334155"></div>
<div style="background:#111827;padding:10px;height:120px;width:40%;color:#38bdf8;font-size:0.8rem;border:1px solid #334155;line-height:1.3">
<b style="color:#fff;border-bottom:1px solid #334155;display:block;margin-bottom:4px">📡 TELEMETRY</b>
E: <span style="color:#22c55e">ON</span> | W: <span style="color:#ec4899">ACT</span><br>S: <span style="color:#eab308">STB</span><br>SYNC: <span id="sy" style="color:#4ade80">100%</span>
</div>
<input type="text" id="t" placeholder="CMD (/overload, /kill, /clear)..." style="background:#000;color:#fff;border:2px solid #4ade80;width:476px;padding:12px;font-family:monospace;font-size:1rem;margin-top:8px;outline:none">
<script>
let bl=document.getElementById('b'),ve=document.getElementById('v'),sh=document.getElementById('s'),l=document.getElementById('l'),t=document.getElementById('t'),sy=document.getElementById('sy'),c=document.getElementById('c').getContext('2d'),bdy=document.getElementById('o');
let fl=false,p=0,n=[{n:"Loopin",x:250,y:100,c:"#38bdf8"},{n:"US-E",x:400,y:50,c:"#22c55e"},{n:"US-W",x:100,y:60,c:"#ec4899"},{n:"US-S",x:250,y:170,c:"#eab308"}];
setInterval(()=> {
bl.innerText=(parseInt(bl.innerText.replace(/,/g,''))+Math.floor(Math.random()*3)).toLocaleString();
if(!fl&&Math.random()<0.08){l.innerHTML+=`<div>[${new Date().toLocaleTimeString()}] [WARN] Variance on US-WEST</div>`;l.scrollTop=l.scrollHeight;}
if(fl){sy.innerText=Math.floor(Math.random()*30+40)+"%";sy.style.color="#f87171";}else{sy.innerText="100%";sy.style.color="#4ade80";}
},1000);
setInterval(()=>{if(fl){bdy.style.background=bdy.style.background==="rgb(239, 68, 68)"?"#0d0f12":"#ef4444";}},400);
setInterval(()=>{
c.clearRect(0,0,500,200);c.strokeStyle='#1e293b';c.lineWidth=0.5;
for(let i=0;i<500;i+=20){c.beginPath();c.moveTo(i,0);c.lineTo(i,200);c.stroke();c.beginPath();c.moveTo(0,i/2.5);c.lineTo(500,i/2.5);c.stroke();}
n.forEach(i=>{c.strokeStyle=i.c;c.lineWidth=2;c.beginPath();c.moveTo(250,100);c.lineTo(i.x,i.y);c.stroke();});
p=(p+0.04)%1;
n.forEach(i=>{if(i.n!=="Loopin"){c.fillStyle='#ffffff';c.beginPath();c.arc(250+(i.x-250)*p,100+(i.y-100)*p,7,0,7);c.fill();}});
n.forEach(i=>{c.fillStyle=i.c;c.beginPath();c.arc(i.x,i.y,9,0,7);c.fill();c.fillStyle='#fff';c.fillText(i.n,i.x+15,i.y+4);});
},30);
t.addEventListener('keydown',(e)=>{
if(e.key==='Enter'&&t.value.trim()!==""){
let v=t.value.trim().toLowerCase();
if(v==='/clear'){l.innerHTML=`<div>[Console purged]</div>`;fl=false;bdy.style.background="#0d0f12";ve.innerText="3";sh.innerText="53";}
else if(v==='/overload'){l.innerHTML+=`<div style="color:#f87171;font-weight:bold">[CRIT] Spawning ghost shards...</div>`;fl=true;ve.innerText="103";sh.innerText="153";}
else if(v==='/kill'){
let cd=10;t.disabled=true;
let tm=setInterval(()=>{
l.innerHTML+=`<div style="color:#ef4444;font-weight:bold">[HALT] REBOOT IN ${cd}s...</div>`;l.scrollTop=l.scrollHeight;cd--;
if(cd<0){clearInterval(tm);fetch('http://127.0.0',{method:'POST'}).catch(()=>{});l.innerHTML=`<div style="color:#f87171">[DEAD] Disconnected.</div>`;}
},1000);
}else{l.innerHTML+=`<div>[CMD] Runtime: ${v}</div>`;}
l.scrollTop=l.scrollHeight;t.value="";
}
});
</script></body></html>
EOF
