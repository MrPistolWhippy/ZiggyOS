path = "/root/workspace/src/shell.c"
with open(path, "r") as f:
    content = f.read()
target_anchor = 'else if (shell_strcmp(shell_buffer, "matrix") == 0) {'
new_command_block = """else if (shell_strcmp(shell_buffer, "aquarius") == 0) {
        shell_print("[NET] Auditing Aquarius Core Interface Link Status...\\n");
        shell_print("[NET] Device: Intel I350 Gigabit Network Connection\\n");
        shell_print("[NET] Status: Hardware Promiscuous Ingest Active.\\n");
    }
    else if (shell_strcmp(shell_buffer, "matrix") == 0) {"""
if target_anchor in content and "aquarius" not in content:
    content = content.replace(target_anchor, new_command_block)
    with open(path, "w") as f:
        f.write(content)
    print("[+] C vocabulary driver arrays expanded with aquarius interface hooks.")
else:
    print("[-] Vocabulary matching offset or already patched.")
EOF
