#!/bin/ash
# ==============================================================================
#   ZIGGY-OS HARDWARE REGISTRY MEMORY MATRIX SENSOR (CYBERPUNK MATRIX VERSION)
# ==============================================================================
DB_PATH="/root/archive.db"
LOG_PATH="/root/sweep_output.log"
TARGET_IMG="/root/virtual_disk.img"
CRIMSON="\033[1;91m"
TEAL="\033[1;96m"
GOLD="\033[1;93m"
WHITE="\033[1;97m"
RESET="\033[0m"
while true; do
    clear
    echo -e "${CRIMSON}======================================================================${RESET}"
    echo -e " ⚡ ${WHITE}ZIGGY-OS HARDWARE MONITORING LAYER${RESET} | ${TEAL}ENGINEER: MAX (MrPistolWhippy)${RESET} ⚡ "
    echo -e "${CRIMSON}======================================================================${RESET}"
    
    # LAYER 1: RAW SYSTEM MEMORY BOUNDARY SCAN (PARSE /PROC/MEMINFO)
    MEM_TOTAL=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo "2048000")
    MEM_FREE=$(awk '/MemFree/ {print $2}' /proc/meminfo 2>/dev/null || echo "1024000")
    MEM_USED=$((MEM_TOTAL - MEM_FREE))
    MEM_PCT=$(( (MEM_USED * 100) / MEM_TOTAL ))
    
    # Dynamic Warning Colors based on RAM Consumption Limits
    if [ "$MEM_PCT" -gt 85 ]; then RAM_COLOR=$CRIMSON; else RAM_COLOR=$TEAL; fi
    
    echo -e "${WHITE}[+] LAYER 1: HARDWARE RAM BOUNDARY REGISTRY:${RESET}"
    echo -e "  - Total Allocated RAM Capacity : ${GOLD}$((MEM_TOTAL / 1024)) MB${RESET}"
    echo -e "  - Active Engine Resource Load  : ${RAM_COLOR}$((MEM_USED / 1024)) MB ($MEM_PCT% Usage)${RESET}"
    echo -e "  - Free Memory Buffer Overhead : ${TEAL}$((MEM_FREE / 1024)) MB${RESET}"
    
    # LAYER 2: SYSTEM WORKSPACE INVENTORY LOG SIZES
    echo -e "\n${WHITE}[+] LAYER 2: LOG CHANNELS & DATA FOOTPRINTS:${RESET}"
    if [ -f "$LOG_PATH" ]; then
        LOG_BYTES=$(wc -c < "$LOG_PATH")
        echo -e "  - Telemetry Pipe Log Size      : ${TEAL}${LOG_BYTES} Bytes (${#LOG_BYTES} stream clusters)${RESET}"
    else
        echo -e "  - Telemetry Pipe Log Size      : ${CRIMSON}OFFLINE / CLOSED${RESET}"
    fi
    
