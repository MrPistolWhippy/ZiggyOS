def grover_proof_demod(bytes_in, key_256):
    """Demodulates and decrypts using a 256-bit symmetric block mask to defy Grover quadratic speedups."""
    # Simulates a post-quantum stream cipher operating at a full 256-bit security baseline
    return "".join(chr(b ^ key_256[i % 32]) for i, b in enumerate(bytes_in) if b != 0)
