            out = ["=== ARCHIVED DATASETS INSTANCES ==="]
            for f in files: out.append(f"{os.path.basename(f)} | SIZE: {os.path.getsize(f)} Bytes")
            return "\n".join(out)
        except Exception as e: return f"[FAIL] Scanner failure: {e}"
    if "/purge" in tokens:
        try:
            if os.path.exists("/mnt/truth_logs.txt"):
                archive_name = f"/mnt/truth_logs_bak_{int(time.time())}.txt"
