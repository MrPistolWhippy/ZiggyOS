import os, time, hashlib
CLIP_PATH = "/dev/clipboard"
DECK_PATH = "/root/unlimited_grid_deck"
G_LOG = "/root/unlimited_grid_deck/active_matrix.log"
def fetch_ios_clipboard():
    """Natively intercepts raw text passing through your iPad clipboard rails."""
    if os.path.exists(CLIP_PATH):
        try:
            with open(CLIP_PATH, "r", encoding="utf-8", errors="ignore") as f:
                return f.read().strip()
        except: return ""
    return ""
def push_ios_clipboard(text_out):
    """Pipes execution strings straight back into your native iPad system memory."""
    if os.path.exists(CLIP_PATH):
