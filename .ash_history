    score = sum(cfg["w"].get(t, 0) for t in tokens)
    analysis = f"| SCORE: {score} (CRIT)" if score > 3 else f"| SCORE: {score} (SAFE)"
    
    if "/verify" in tokens: res = f"[EVAL] Verifying integrity: {' '.join(tokens[1:])} {analysis}"
    elif "/status" in tokens: res = "[READY] Pathways standard. 0 threats mapped."
    else: res = f"[LOGIC] Ingestion: {' '.join(tokens)} {analysis}"
        
    try:
        with open("/mnt/truth_logs.txt", "a") as f: f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {res}\n")
        if os.path.getsize("/mnt/truth_logs.txt") > cfg["ceil"]:
            print(f"⚠️ [THRESHOLD WARNING] Live tracker footprint > {cfg['ceil']} Bytes. Run /purge.")
