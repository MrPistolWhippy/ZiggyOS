    <div class="node" style="top: 180px; left: 40%;">Autonomous Peer Loopin<br>(127.0.0.1:9076)</div>
    <div class="node node-dot" style="top: 60px; left: 15%;">US-EAST-ATLANTIC</div>
    <div class="node node-dot" style="top: 80px; left: 70%;">US-WEST-PACIFIC</div>
    <div class="node node-dot" style="top: 300px; left: 20%;">US-CENTRAL-PLAINS</div>
    <div class="node node-dot" style="top: 320px; left: 65%;">US-SOUTH-BORDER</div>
