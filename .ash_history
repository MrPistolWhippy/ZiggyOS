        print(f"   {WHITE}SPECTRUM {R} : {Y}0x{h}{R} │ {C}144.777 MHz Active{R}")
        print(f"   {WHITE}POSITION {R} : {C}-36.790 S, 174.750 E{R} │ {G}AKL ANCHOR{R}")
        print(f"{O}├──────────────────────────────────────────────┤{R}")
        print(f"   {M}📡 HARDWARE CHANNELS & SIGNAL LOGS{R}")
        print(f"   » {K}NADA{R} │ 999,999,999,432 Hz │ [{G}LOCKED{R}]")
        print(f"   » {C}WAN {R} │ Drift: -{wan_drift} Hz Offset │ [{P}STABLE{R}]")
        print(f"   » {P}CEL {R} │ Forensic Extr Core  │ [{G}UNSEAL{R}]")
        print(f"   » {W}ESO {R} │ ▲ [🜁] ☿ 🜚 🜔 [🜃]     │ [{C}HARMONIZED{R}]")
        print(f"{O}├──────────────────────────────────────────────┤{R}")
        
        # Five-Tier Rep Pools
        for n, p, col in [("A", "alpha", G), ("B", "beta", C), ("C", "charlie", Y), ("D", "delta", P), ("E", "sammy", W)]:
            print(f"   » {col}TRACK_{n}{R} │ /root/track_{p:<7} │ [{G}READY{R}]")
        print(f"{O}├──────────────────────────────────────────────┤{R}")
        
        # Local Binaries Verification
        for path, name in static_paths:
            st = f"{G}OK{R}" if os.path.exists(path) else f"{P}??{R}"
