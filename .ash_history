#!/usr/bin/env python3
import sys, socket, threading, time, random, hashlib
KEYS = {
    "DOWNTOWN": {"port": 44901, "f": "Hat Man Tracking"},
    "MIDTOWN":  {"port": 44902, "f": "Empire Chains"},
    "UPTOWN":   {"port": 44903, "f": "Obscure Retrieval"}
}
QUEUE, lock = [], threading.Lock()
def get_obscure_w(text):
    clean = "".join(c.upper() for c in text if c.isalpha())
    o = sum(ord(c)-64 for c in clean) if clean else 0
    k = sum((ord(c)-64+26) if c>='K' else (ord(c)-64) for c in clean) if clean else 0
    b = (o * len(clean)) % 999
    return f"O:{o}|K:{k}|B:{b}"
def sim_signals(sec, p):
    try:
        s = socket.socket()
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind(("127.0.0.1", p)); s.listen(5)
        while True:
            c, _ = s.accept()
            n = random.randint(1000, 9999)
            h = hashlib.sha256(f"{sec}_{time.time()}_{n}".encode()).hexdigest()[:16].upper()
            
            # --- PLAIN ENGLISH TRANSLATION PAYLOAD ARRAY ---
            if sec == "DOWNTOWN":
                msg = f"🎩 [UNVEIL] Target Identified: Hat Man (Marker ID {n}) | Signal Security: Secure 16-Char Signature Generated [0x{h}] | Status: Tracking Stream Active.\n"
            elif sec == "MIDTOWN":
                msg = f"⛓️ [BREAK] System Action: Severing Restrictive Privilege Linkages (Link ID {n}) | Network Boundary: Confirmed Safe at Non-Root Ring 3 Level [0x{h}].\n"
            else:
                w = get_obscure_w(f"RET_{n}")
                msg = f"✨ [RETRIEVE] Spatial Telemetry Synchronized: Node {n} Successfully Harmonized | Cryptographic Nonce Map: 0x{h} | Mathematical Matrix Weight Tags: {w}.\n"
                
            try:
                with open("/root/transmission_diary.log", "a") as f: f.write(msg)
            except: pass
            c.sendall(msg.encode()); c.close(); time.sleep(random.uniform(0.1, 0.4))
    except: pass
def listen_signals(sec, p):
    while True:
        try:
            s = socket.socket(); s.settimeout(1.0); s.connect(("127.0.0.1", p))
            msg = s.recv(1024).decode().strip(); s.close()
            if msg:
                with lock:
                    QUEUE.append(msg)
                    if len(QUEUE) > 8: QUEUE.pop(0)
        except: pass
        time.sleep(0.2)
def run():
    for s, cfg in KEYS.items():
        threading.Thread(target=sim_signals, args=(s, cfg["port"]), daemon=True).start()
        threading.Thread(target=listen_signals, args=(s, cfg["port"]), daemon=True).start()
    
    C, P, G, R = "\033[38;5;51m", "\033[38;5;93m", "\033[38;5;242m", "\033[0m"
    try:
        while True:
            sys.stdout.write("\033[H\033[J")
            print(f"{C}⚡ ZIGGY-OS : OPERATION MANHATTAN PLAIN-ENGLISH STREAM v4.0{R}\n{G}" + "-"*78 + f"{R}")
            print(f"  [🛡️ MODE] INJECT-BEFORE-TRANSMIT LIVE  |  [🔮 LAYER] PLAIN-ENGLISH TELEMETRY INTERCEPT")
            print(f"{G}" + "-"*78 + f"{R}")
            with lock:
                if not QUEUE: print(f"  {G}[*] Accessing multi-socket regional channels across 144.777 spectrum...{R}")
                else:
                    for m in reversed(QUEUE):
                        if "HAT_MAN" in m or "Hat Man" in m: print(f"  {C}{m}{R}")
                        elif "EMPIRE" in m or "Severing" in m: print(f"  {P}{m}{R}")
                        else: print(f"  \033[38;5;15m{m}\033[0m")
            sys.stdout.flush(); time.sleep(0.3)
    except KeyboardInterrupt: print("\n[+] Plain English translation stream detached cleanly.")
if __name__ == "__main__": run()
EOF
