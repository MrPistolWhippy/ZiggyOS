#!/bin/bash
set -e
echo "==> Searching for the pre-deployed RISC-V compiler toolchain..."
COMPILER_PATH=$(find / -name "riscv64-unknown-elf-gcc" -o -name "riscv32-unknown-elf-gcc" 2>/dev/null | head -n 1)
if [ -z "$COMPILER_PATH" ]; then
    echo "❌ Error: Could not find the RISC-V compiler anywhere on the filesystem."
    echo "Please check the 'Deploy GNU RISC-V Core' step in your GitHub Actions YAML to see where it installs."
    exit 1
fi
TOOLCHAIN_BIN_DIR=$(dirname "$COMPILER_PATH")
BINARY_NAME=$(basename "$COMPILER_PATH")
echo "✅ Found compiler at: $COMPILER_PATH"
echo "==> Exporting toolchain path..."
export PATH="$TOOLCHAIN_BIN_DIR:$PATH"
echo "==> Stripping stdio.h dependencies from source..."
sed -i 's/#include <stdio.h>/\/\/ #include <stdio.h>/g' riscv_driver.c
echo "==> Compiling freestanding bare-metal binary using $BINARY_NAME..."
$BINARY_NAME -march=rv32i -mabi=ilp32 -ffreestanding -nostdlib riscv_driver.c watchdog.o -o riscv_test_bench
echo "🎉 Build successful!"
EOF
chmod +x find_and_build.sh && ./find_and_build.sh
