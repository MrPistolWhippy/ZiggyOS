sed -i 's/#include <stdint.h>/\/\/ #include <stdint.h>/g' riscv_driver.c
echo "==> Running your target compilation string..."
# -ffreestanding skips the missing crt0.o and OS dependencies seamlessly
riscv64-unknown-elf-gcc -march=rv32ifd -mabi=ilp32d -ffreestanding -nostdlib riscv_driver.c watchdog.o -o riscv_test_bench
echo "🎉 Success! The compiled 'riscv_test_bench' binary is fully generated."
EOF
