      { id: 4, label: 'US-CENTRAL-PLAINS\n(10 Peers Map)', color: '#111827', font: { color: '#14b8a6', face: 'monospace' }, shape: 'dot', size: 25 },
      { id: 5, label: 'US-SOUTH-BORDER\n(10 Peers Map)', color: '#111827', font: { color: '#14b8a6', face: 'monospace' }, shape: 'dot', size: 25 },
      { id: 6, label: 'US-NORTH-LAKES\n(10 Peers Map)', color: '#111827', font: { color: '#14b8a6', face: 'monospace' }, shape: 'dot', size: 25 }
    ]);
    var edges = new vis.DataSet([
      { from: 1, to: 2, color: '#14b8a6', width: 2, arrows: 'to;from' },
