cat << 'EOF' > api_server.py
import http.server, json, os, sys
class IntegrationHandler(http.server.SimpleHTTPRequestHandler):
    def do_POST(self):
        if self.path == '/api/kernel':
            content_length = int(self.headers['Content-Length'])
            post_data = json.loads(self.rfile.read(content_length).decode('utf-8'))
            action = post_data.get('action')
            node = post_data.get('node', 'Unknown')
            
            if action == 'clear_cache':
                os.system('sync && echo 3 > /proc/sys/vm/drop_caches')
                response = {"status": "SUCCESS", "log": "[iSH KERNEL] Memory Cache Buffers Purged Cleanly."}
            elif action == 'node_interact':
                response = {"status": "SUCCESS", "log": f"[MESH EVENT] Interfaced directly with {node}."}
            elif action == 'sys_reboot':
                response = {"status": "SUCCESS", "log": "[KERNEL] Executing immediate system runtime reload..."}
                # Broadcast response before killing python processes
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps(response).encode('utf-8'))
                os.system('pkill -f load_balancer; pkill -f location; kill 1')
                sys.exit(0)
            else:
                response = {"status": "ERROR", "log": "Unknown request string."}
                
            if action != 'sys_reboot':
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps(response).encode('utf-8'))
        else:
            self.send_response(404)
            self.end_headers()
print("[INTEGRATION ENGAGED] API Command Pipeline Listening over Port 8080...")
http.server.HTTPServer(('0.0.0.0', 8080), IntegrationHandler).serve_forever()
EOF
python3 -c "
with open('dashboard_panel.html', 'r') as f: html = f.read()
# 1. Identify specific metric targets for fluctuation
html = html.replace('1,540 Blocks', '<span id=\"m_blocks\">1,540</span> Blocks')
html = html.replace('3 Vectors', '<span id=\"m_vectors\">3</span> Vectors')
html = html.replace('53 Shards', '<span id=\"m_shards\">53</span> Shards')
# 2. Add the System Reboot button layout right next to the cache flush button
btn_old = '[ADMIN OVERRIDE] PURGE iSH MEMORY CACHE CACHE</button>'
btn_new = '[ADMIN OVERRIDE] PURGE iSH MEMORY CACHE</button><button onclick=\"sendKernelCmd(\x27sys_reboot\x27)\" style=\"margin-top:10px;background:#ef4444;color:#fff;border:none;padding:8px 12px;font-family:monospace;font-weight:bold;border-radius:4px;cursor:pointer;width:100%;margin-left:5px;box-shadow:0 0 10px rgba(239,68,68,0.3);\">[SYS OVERRIDE] RESET KERNEL TERMINAL ENVIRONMENT</button>'
html = html.replace(btn_old, btn_new)
# 3. Update the flex button container style to let them sit side-by-side cleanly
html = html.replace('width:100%;\"', 'width:50%;\"')
# 4. Append the JavaScript live performance metric calculator loop
js_loop = '''
  // Fluctuating Resource System Engine Loop
  setInterval(() => {
    const blocks = document.getElementById(\"m_blocks\");
    const vectors = document.getElementById(\"m_vectors\");
    const shards = document.getElementById(\"m_shards\");
    
    if (blocks) blocks.innerText = (parseInt(blocks.innerText) + Math.floor(Math.random() * 3) - 1).toLocaleString();
    if (vectors && Math.random() > 0.85) vectors.innerText = Math.floor(Math.random() * 5);
    if (shards && Math.random() > 0.7) shards.innerText = Math.max(45, Math.min(60, parseInt(shards.innerText) + (Math.random() > 0.5 ? 1 : -1)));
  }, 3000);
</script>'''
html = html.replace('</script>\\n</body>', js_loop + '\\n</body>')
with open('dashboard_panel.html', 'w') as f: f.write(html)
print('[SUCCESS] Interactive layout and live metrics modifications deployed!')
"
