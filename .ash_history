#!/bin/sh
echo "Wiping stale backend sockets..."
killall -9 python3 2>/dev/null
pkill -f python3 2>/dev/null
echo "Starting ZIGGY-OS Core Loop Pipeline..."
python3 /mnt/api_server.py &
sleep 1
echo "==========================================="
echo "Pipeline established. Select an injection option:"
echo "1) Trigger Node Intercept Matrix"
echo "2) Flush Memory Cache Buffers"
echo "3) Force Core Kernel Reboot Sequence"
echo "==========================================="
read -p "Enter Choice (1-3): " choice
case $choice in
    1) curl -X POST -H "Content-Type: application/json" -d '{"action":"node_intercept"}' http://localhost:8080/api/kernel ;;
    2) curl -X POST -H "Content-Type: application/json" -d '{"action":"clear_cache"}' http://localhost:8080/api/kernel ;;
    3) curl -X POST -H "Content-Type: application/json" -d '{"action":"sys_reboot"}' http://localhost:8080/api/kernel ;;
    *) echo "Invalid pipeline vector sequence." ;;
esac
EOF
