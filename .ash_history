import socket, threading, json, os, time
P, HOP, CHUNK, stats = 7001, 7002, 4096, {'pkts': 0, 'bytes': 0, 'files': []}
def listen():
    s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('127.0.0.1', P)); s.listen()
    print(f"\033[1;32m[ONLINE]\033[0m Monitoring Lane {P} -> Relay to {HOP}")
    while True:
        c, _ = s.accept(); rl = b''
        while not rl.endswith(b'\n'): rl += c.recv(1)
        meta = json.loads(c.recv(int(rl.strip())).decode())
        
        # Fixed: Use flat double quotes to prevent syntax quote collisions
        file_id = meta['file']
        fn = f"tel_tmp_{P}_{file_id}"
        print(f"\n\033[1;33m[UNPACK]\033[0m Unpacking: {file_id} ({meta['size']} B) targeting Node {meta['target']}")
        
        with open(fn, 'wb') as out:
            rb = 0
            while rb < meta['size']:
                k = c.recv(min(CHUNK, meta['size'] - rb)); out.write(k); rb += len(k)
                stats['bytes'] += len(k); stats['pkts'] += 1
        if file_id not in stats['files']: stats['files'].append(file_id)
        print(f"\033[1;35m[METRIC]\033[0m Handled: {stats['pkts']} packets | Total Volume: {stats['bytes']} Bytes")
        if meta['target'] != P:
            try:
                mb = json.dumps(meta).encode(); sk = socket.socket(); sk.connect(('127.0.0.1', HOP))
                sk.sendall(f"{len(mb)}\n".encode() + mb)
                with open(fn, 'rb') as f:
                    while chunk := f.read(CHUNK): sk.sendall(chunk)
                sk.close(); os.remove(fn); print(f"\033[1;34m[RELAY]\033[0m Forwarded to Node {HOP}")
            except Exception as e: print(f"[ERR] {e}")
        else: print(f"\033[1;32m[LANDED]\033[0m Kept locally -> {fn}")
def view(): print(f"\n\033[1;36m[STATS]\033[0m Packets: {stats['pkts']} | Bytes: {stats['bytes']} | Files: {stats['files']}\n>>> ")
threading.Thread(target=listen, daemon=True).start(); time.sleep(0.2)
import code; code.interact(banner="", local={'dashboard': view, 'stats': stats})
