python
import hashlib
import random
def generate_crypto_id(name: str) -> int:
    """Generates a stable integer ID from a string using SHA-256."""
    sha256_hash = hashlib.sha256(name.encode('utf-8')).hexdigest()
    # Convert hex hash to integer representation for bitwise operations
    return int(sha256_hash, 16)
class DecentralizedNode:
    def __init__(self, node_name: str):
        self.node_name = node_name
        self.node_id = generate_crypto_id(node_name)
        # Kademlia routing table bucket: maps known node IDs to their names
        self.routing_table = {} 
    def calculate_xor_distance(self, target_id: int) -> int:
        """Core Kademlia Metric: Computes logical distance via bitwise XOR."""
        return self.node_id ^ target_id
    def register_peer(self, peer_node: 'DecentralizedNode'):
        """Adds a known peer to the local routing directory."""
        if peer_node.node_id != self.node_id:
            self.routing_table[peer_node.node_id] = peer_node.node_name
    def query_closest_peers(self, target_id: int, count: int = 2) -> list:
        """Finds the closest known peers to a target ID based on XOR metric."""
        # Calculate distance for every node currently in the local routing table
        peer_distances = [
            (self.calculate_xor_distance(peer_id) ^ target_id, peer_id, name)
            for peer_id, name in self.routing_table.items()
        ]
        # Sort by proximity (lowest XOR distance comes first)
        peer_distances.sort(key=lambda x: x[0])
        return [(peer_id, name) for _, peer_id, name in peer_distances[:count]]
# =====================================================================
# SIMULATION WORKSPACE: DECENTRALIZED MESH INITIALIZATION
# =====================================================================
# 1. Establish the authoritative Bootstrap Node (The stable network anchor)
bootstrap_server = DecentralizedNode("BOOTSTRAP_GATEWAY_NODE")
# 2. Populate the global network space with independent peers
network_nodes = [
    DecentralizedNode("Alpha_Node"),
    DecentralizedNode("Beta_Node"),
    DecentralizedNode("Gamma_Node"),
    DecentralizedNode("Delta_Node")
]
# Connecting network nodes explicitly to the bootstrap gateway
for node in network_nodes:
    bootstrap_server.register_peer(node)
    node.register_peer(bootstrap_server)
# 3. Initialize a new isolated node ("p20") into the mesh topology
p20_node = DecentralizedNode("node_p20")
print(f"[INITIALIZATION] Node 'p20' Cryptographic ID: {p20_node.node_id}\n")
# --- STEP A: BOOTSTRAP CONNECTION ---
# Node p20 queries the static bootstrap server to pull its initial map layout
print(f"[*] p20 connecting to bootstrap anchor: '{bootstrap_server.node_name}'...")
p20_node.register_peer(bootstrap_server)
# Copy routing entries shared from the bootstrap node's routing tables
for peer_id, peer_name in bootstrap_server.routing_table.items():
    if peer_id != p20_node.node_id:
        p20_node.routing_table[peer_id] = peer_name
print(f"[+] Bootstrap routing tables synced. Current p20 routing pool size: {len(p20_node.routing_table)} nodes.\n")
# --- STEP B: ITERATIVE XOR ROUTING LOOP ---
# Suppose node p20 needs to locate the peer closest to a specific data hash
target_data_key = generate_crypto_id("Target_Secret_Payload_Hash")
print(f"[*] Routing data query for file target hash key: {target_data_key}")
# Query local tables recursively to converge on the closest matching target profile
closest_contacts = p20_node.query_closest_peers(target_data_key, count=1)
if closest_contacts:
    target_id, target_name = closest_contacts[0]
    logical_distance = p20_node.calculate_xor_distance(target_id)
    print(f"[SUCCESS] Target data resolved to peer node: '{target_name}'")
    print(f"[METRIC] Mathematical XOR Distance: {logical_distance}")
#!/usr/bin/env bash
# ---------------------------------------------------------------------
# DECENTRALIZED LOCAL NETWORK ROUTING & MAP DISCOVERY TOOL
# ---------------------------------------------------------------------
# Core variables and formatting definitions
GREEN='\033[0;32m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m' # No Color
# 1. Determine local subnet layout automatically
get_local_subnet() {
    # Extract active interface IP address, fallback to localhost loopback if offline
    local active_ip
    active_ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7}')
    if [ -z "$active_ip" ]; then
        active_ip=$(hostname -I | awk '{print $1}')
    fi
    
    if [ -z "$active_ip" ] || [ "$active_ip" == "127.0.0.1" ]; then
        echo "127.0.0"
    else
        # Trim off the host portion to leave the network identifier prefix (e.g., 192.168.1)
        echo "$active_ip" | cut -d'.' -f1-3
    fi
}
# 2. Cryptographic Content Hashing (Simulating unique ID assignment)
generate_node_id() {
    local input_string="$1"
    # Generate SHA-256 string footprint to assign every found node a deterministic hash
    echo -n "$input_string" | sha256sum | awk '{print $1}'
}
# 3. Execution Initialization Banner
SUBNET=$(get_local_subnet)
echo -e "${GREEN}[*] INITIALIZING NETWORK TOPOLOGY MAPPING FRAMEWORK...${NC}"
echo -e "${CYAN}[*] Target Discovery Scan Range: ${SUBNET}.1 to ${SUBNET}.254${NC}"
echo "---------------------------------------------------------------------"
echo -e "IP ADDRESS\t\tCRYPTOGRAPHIC NODE IDENTIFIER (SHA-256)"
echo "---------------------------------------------------------------------"
# 4. Iterative Discovery Scan Loop
# Adjust index range block locally to limit scan duration if required (e.g., 1..20)
for host in {1..254}; do
    TARGET_IP="${SUBNET}.${host}"
    
    # Send a single quick ICMP ping packet with a 1-second timeout constraint
    if ping -c 1 -W 1 "$TARGET_IP" >/dev/null 2>&1; then
        # On connection success, calculate a unique cryptographic identity node map
        NODE_HASH=$(generate_node_id "$TARGET_IP")
        echo -e "${GREEN}${TARGET_IP}${NC}\t${NODE_HASH}"
        
        # 5. Core Interface Audit (Scan specific common P2P/SSH administrative channels)
        # 22 = SSH Terminal, 80 = HTTP, 443 = HTTPS, 5001 = InterPlanetary File System (IPFS) API
        for port in 22 80 443 5001; do
            # Use Bash's native pseudo-device network socket redirection to verify open ports
            if (echo > /dev/tcp/"$TARGET_IP"/"$port") >/dev/null 2>&1; then
                echo -e "   └── ${CYAN}[OPEN PORT]${NC} Port $port detected active on this target node."
            fi
        done
    fi
done
echo "---------------------------------------------------------------------"
echo -e "${GREEN}[SUCCESS] Network topology map generation sequence finished.${NC}"
