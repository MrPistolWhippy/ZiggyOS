from http.server import BaseHTTPRequestHandler, HTTPServer
class ZK(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_GET(self):
        self.send_response(200); self.end_headers()
        with open('/mnt/dashboard_panel.html', 'rb') as f: self.wfile.write(f.read())
    def do_POST(self):
        self.send_response(200); self.end_headers()
        print("\n⚡ [CRITICAL KILL] Process shutdown hook triggered from Safari panel!"); os.system("pkill -f python3"); sys.exit(0)
if __name__ == '__main__': HTTPServer(('0.0.0.0', 8080), ZK).serve_forever()
