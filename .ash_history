import socket, threading, sqlite3, base64, time, os, collections, shutil, random, hashlib, struct
P, D, CF, R = 9876, "transmission_diary.log", ".cycle_counter", "dashboard_report.html"
def rsa_enc(t, k=(17, 3233)): return "l".join(str(pow(ord(c), k[0], k[1])) for c in t)
def rsa_dec(c, k=(2753, 3233)):
    try: return "".join(chr(pow(int(x), k[0], k[1])) for x in c.split("l") if x)
    except: return "[!] Disruption"
