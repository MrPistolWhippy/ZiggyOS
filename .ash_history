                        self.wfile.flush()
                    except: break
                time.sleep(0.1)
    def do_POST(self):
        content_length = int(self.headers['Content-Length'])
        post_data = self.rfile.read(content_length).decode('utf-8')
        try:
            data = json.loads(post_data)
            if "msg" in data:
                raw = data["msg"].strip().split()
                cmd = raw[0].lower() if len(raw) > 0 else ""
                pwd = raw[1] if len(raw) > 1 else ""
                # Lock validation matrix
                if cmd in ["/boost", "/isolate", "/overload"] and pwd != "max123":
                    log_queue.append({"type":"log", "msg":"🔒 [AUTH ERROR] Access Denied. Valid passcode missing."})
                else:
                    if cmd == "/boost":
                        db["blocks"] += 5000
                        log_queue.append({"type":"log", "msg":"⚡ [EXEC] Storage expanded +5000 Blocks."})
                    elif cmd == "/isolate":
                        db["vectors"] = 0
                        log_queue.append({"type":"log", "msg":"🛡️ [SECURE] Threat tracking cleared."})
                    elif cmd == "/overload":
                        db["shards"] += 100
                        log_queue.append({"type":"alert", "msg":"🚨 [CRIT OVERLOAD] 100 Ghost Shards Spawned!"})
                    else:
                        log_queue.append({"type":"log", "msg":f"[CMD] Stdin string logged: {' '.join(raw)}"})
                sys.stdout.flush()
        except: pass
        self.send_response(200)
        self.end_headers()
if __name__ == '__main__':
    HTTPServer(('0.0.0.0', 8080), ZiggyOSHandler).serve_forever()
EOF
