import json
from http.server import BaseHTTPRequestHandler, HTTPServer
DB = "north_shore_archive.json"
class LocalHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/archive":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            with open(DB, "r") as f:
                self.wfile.write(f.read().encode())
        else:
            self.send_error(404)
    def do_POST(self):
        if self.path == "/archive/update":
            length = int(self.headers["Content-Length"])
            body = json.loads(self.rfile.read(length).decode())
            
            with open(DB, "r+") as f:
                data = json.load(f)
                data.setdefault(body["key"], {})[body["field"]] = body["value"]
                f.seek(0)
                json.dump(data, f, indent=2)
                f.truncate()
                
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"status": "Updated offline"}')
if __name__ == "__main__":
    server = HTTPServer(("127.0.0.1", 8000), LocalHandler)
    print("Native offline server running on http://127.0.0.1:8000")
    server.serve_forever()
EOF
