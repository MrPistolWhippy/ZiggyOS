import sqlite3, hashlib, struct
DB = "archive.db"
print("\n\033[1;33m[🛡️ AUDITOR] INITIALIZING IMMUTABLE CHAIN INTEGRITY VERIFICATION...\033[0m")
try:
    conn = sqlite3.connect(DB); cursor = conn.cursor()
    cursor.execute("SELECT block_idx, payload, prev_hash FROM p6_ledger ORDER BY block_idx ASC")
    rows = cursor.fetchall(); expected_prev = "0"*64; tampered = False
    for row in rows:
        idx, b_payload, p_hash = row
        if p_hash != expected_prev:
            print(f"\033[1;31m[🚨 TAMPERING DETECTED] Block #{idx} lineage broken! Expected: {expected_prev[:16]}... Got: {p_hash[:16]}...\033[0m")
            tampered = True; break
        expected_prev = hashlib.sha256(b_payload + p_hash.encode()).hexdigest()
    if not tampered: print("\033[1;32m[✅ AUDIT CLEAR] Cryptographic block lineage verified. Ledger integrity 100% pristine.\033[0m")
    conn.close()
except Exception as e: print(f"[!] Audit aborted: {e}")
