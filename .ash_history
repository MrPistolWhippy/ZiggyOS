import socket
import urllib.request
import json
import time
TARGET_DOMAINS = [
    "dns.google", 
    "one.one.one.one", 
    "fis-ski.com"
]
def run_global_route_assessment():
    print("=======================================================")
    print("        GLOBAL NETWORK SOCKET DATA FLOW LOGGER        ")
    print("=======================================================")
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
    print(f"Timestamp : {timestamp}")
    print("Protocol  : Native POSIX Sockets (TCP/IP Streams)")
    print("-------------------------------------------------------")
    
    # 1. Probe Public Internet Route Interface
    print(">> Pinging public infrastructure to verify route visibility...")
    try:
        req = urllib.request.Request("https://1.1.1", headers={'User-Agent': 'Mozilla/5.0'})
        with urllib.request.urlopen(req, timeout=3) as response:
            status = "CONNECTED"
            bytes_received = len(response.read())
    except Exception as e:
        status = "ROUTE_BLOCKED"
        bytes_received = 0
        print(f" [ALERT] Live network gateway unavailable: {e}")
        print(" [INFO] System is holding its strict offline air-gap.")
    
    print(f">> Gateway Status : {status} (Data Transferred: {bytes_received} bytes)")
    print("-------------------------------------------------------")
    
    # 2. Map Active Domain Resolutions Natively
    print(">> Resolving public domain name maps over active links:")
    for domain in TARGET_DOMAINS:
        try:
            resolved_ip = socket.gethostbyname(domain)
            print(f"  [+] {domain.ljust(18)} -> Remote IP: {resolved_ip}")
        except Exception:
            print(f"  [-] {domain.ljust(18)} -> Resolution Failed (Offline)")
            
    print("=======================================================")
if __name__ == "__main__":
    run_global_route_assessment()
