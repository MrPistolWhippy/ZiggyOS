/* ==============================================================================
   ZIGGYOS BARE-METAL ASSEMBLY INITIALIZATION MODULE (TARGET: RISC-V/ARM CORTEX)
   ============================================================================== */
.section .text.boot
.global _start
_start:
    /* 1. Disable global chip interrupts and clear CPU registers */
    csrci mstatus, 8       /* Clear Machine Interrupt Enable on RISC-V cores */
    la sp, _stack_top      /* Initialize physical Hardware Stack Pointer */
    /* 2. Zero-out the System BSS section layout framework bounds */
    la a0, __bss_start
    la a1, __bss_end
clear_bss:
    bge a0, a1, init_main
    sw zero, 0(a0)
    addi a0, a0, 4
    j clear_bss
init_main:
    /* 3. Transfer raw execution priority straight to hardware main loop */
    jal ra, main_kernel_entry
halt_state:
    wfi                    /* Wait For Interrupt: Low-power infinite lock */
    j halt_state
