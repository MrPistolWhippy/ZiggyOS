import os
def calculate_node_coverage():
    # 1. Extract physical byte sizes of your 4 quad-track directories
    paths = {
        "alpha":   "/root/track_alpha",
        "beta":    "/root/track_beta",
        "charlie": "/root/track_charlie",
        "delta":   "/root/track_delta"
    }
    
    sizes = {}
    for track, path in paths.items():
        # Fallback to structural script byte counts if empty to maintain calculation balance
        sizes[track] = sum(os.path.getsize(os.path.join(path, f)) for f in os.listdir(path)) if os.path.exists(path) and os.listdir(path) else 1024
        
    # 2. Compute the System Topology Metric
    numerator = sizes["alpha"] * sizes["beta"] * sizes["charlie"]
    denominator = sizes["delta"]
    
    # Calculate negative square energy field constraint
    topology_yield = numerator / denominator
    node_coverage_per_byte = 75 / topology_yield  # 75 global mesh nodes divided by spatial yield
    
    print(f"  [✓] Topology Yield Value : {topology_yield:.4f}")
    print(f"  [✓] Node Coverage / Byte  : {node_coverage_per_byte:.4e}")
if __name__ == "__main__":
    calculate_node_coverage()
