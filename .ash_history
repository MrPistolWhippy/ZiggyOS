        for n, p, col in [("A","alpha",G),("B","beta",C),("C","charlie",Y),("D","delta",P),("E","sammy",W),("F","fox",K)]:
            print(f"   » {col}TRACK_{n}{R} │ /root/track_{p:<7} │ State : [ {G}READY{R} ]")
