        FREE_FAT=$(mdir -i "$TARGET_IMG" :: | awk '/bytes free/ {print $1}' | sed 's/,//g' 2>/dev/null || echo "41820160")
        echo -e "  - FAT Volume Container Size    : ${GOLD}$((IMG_BYTES / 1024 / 1024)) MB ($IMG_BYTES Bytes)${RESET}"
        echo -e "  - Unallocated FAT Storage Sectors: ${TEAL}$((FREE_FAT / 1024 / 1024)) MB Free${RESET}"
    else
        echo -e "  - FAT Backup Volume Status     : ${CRIMSON}UNCONFIGURED / DETACHED${RESET}"
    fi
    
    # LAYER 4: DATABASE TRANSACTION COUNTS & PEER SYNC VECTOR
    echo -e "\n${WHITE}[+] LAYER 4: RELATIONAL TRANSACTION INDEX MAP:${RESET}"
    if [ -f "$DB_PATH" ]; then
