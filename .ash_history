cat << 'EOF' > ziggyos_core.py
import socket, threading, json, os, time, hashlib
P, CHUNK, stats =, 4096, {}
for p in P: stats[p] = {'pkts': 0, 'bytes': 0, 'speed': 0.0, 'file': 'None', 'status': 'IDLE'}
def listen(port):
    s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(('127.0.0.1', port)); s.listen()
    while True:
        try:
            c, _ = s.accept(); rl = b''
            while not rl.endswith(b'\n'): rl += c.recv(1)
            meta = json.loads(c.recv(int(rl.strip())).decode())
            fn, t0, rb = f"n_{port}_{meta['file']}", time.time(), 0
            stats[port].update({'file': meta['file'], 'status': 'DOWNLOADING'})
            with open(fn, 'wb') as o:
                while rb < meta['size']:
                    k = c.recv(min(CHUNK, meta['size'] - rb)); o.write(k); rb += len(k)
                    stats[port]['bytes'] += len(k); stats[port]['pkts'] += 1
            dt = time.time() - t0
            stats[port]['speed'] = (rb / 1024 / 1024) / dt if dt > 0 else 0
            h = hashlib.sha256()
            with open(fn, 'rb') as f:
                while chunk := f.read(CHUNK): h.update(chunk)
            stats[port]['status'] = 'VERIFIED' if h.hexdigest() == meta['hash'] else 'FAIL'
            if meta['target'] != port:
                push(7002 if port == 7001 else 7003, meta, fn); os.remove(fn)
        except: pass
def push(hop, meta, fp):
    try:
