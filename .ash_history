import json
from fastapi import FastAPI
from pydantic import BaseModel
app = FastAPI()
DB = "north_shore_archive.json"
class UpdateData(BaseModel):
    key: str
    field: str
    value: str
def r(): return json.load(open(DB, "r"))
def w(d): json.dump(d, open(DB, "w"), indent=2)
@app.get("/archive")
def get_all(): return r()
@app.post("/archive/update")
